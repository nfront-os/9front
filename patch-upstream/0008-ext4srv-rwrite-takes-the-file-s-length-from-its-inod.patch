From e336f8222818b897634d34f5e23ff28049a52a1a Mon Sep 17 00:00:00 2001
From: Stefan Hertenberger <erde74@gmail.com>
Date: Sat, 31 Oct 2026 10:36:26 +0100
Subject: [PATCH 08/25] ext4srv: rwrite takes the file's length from its inode

An open file (ext4_file) keeps the length it had when it was opened.
rwrite() fills the gap from the end to the write's offset with zeros
using that length: after another fid had made the file longer, the fill
wrote zeros over that fid's data; after another fid had truncated it,
the gap was not filled at all. Two fids writing one file lost data.

Read the length from the inode before the fill.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sys/src/cmd/ext4srv/ext4srv.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/sys/src/cmd/ext4srv/ext4srv.c b/sys/src/cmd/ext4srv/ext4srv.c
index 28f7ac21d..2fce61068 100644
--- a/sys/src/cmd/ext4srv/ext4srv.c
+++ b/sys/src/cmd/ext4srv/ext4srv.c
@@ -493,6 +493,23 @@ rread(Req *r)
 	respond(r, nil);
 }
 
+/*
+ * a file's length from its inode: an ext4_file keeps the one it had
+ * when it was opened, a wstat or write through another fid may have
+ * changed it since.
+ */
+static u64int
+filesize(ext4_file *f)
+{
+	struct ext4_inode_ref ref;
+
+	if(ext4_fs_get_inode_ref(&f->mp->fs, f->inode, &ref) == 0){
+		f->fsize = ext4_inode_get_size(&f->mp->fs.sb, ref.inode);
+		ext4_fs_put_inode_ref(&ref);
+	}
+	return f->fsize;
+}
+
 static void
 rwrite(Req *r)
 {
@@ -501,6 +518,7 @@ rwrite(Req *r)
 
 	a = r->fid->aux;
 	if(a->type == Afile){
+		filesize(a->file);
 		while(ext4_fsize(a->file) < r->ifcall.offset){
 			ext4_fseek(a->file, 0, 2);
 			sz = MIN(r->ifcall.offset-ext4_fsize(a->file), sizeof(zero));
