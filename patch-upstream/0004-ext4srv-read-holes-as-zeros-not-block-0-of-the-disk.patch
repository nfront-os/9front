From 84bb9a447fe97039045f728a1fd69ad8f157bf7e Mon Sep 17 00:00:00 2001
From: Stefan Hertenberger <erde74@gmail.com>
Date: Sat, 31 Oct 2026 10:35:10 +0100
Subject: [PATCH 04/24] ext4srv: read holes as zeros, not block 0 of the disk

ext4_fread() handled a hole (a block not allocated, physical block 0)
only in the partial first block. In the loop over whole blocks and in
the partial last block it read physical block 0 of the partition, the
boot block and superblock area, into the file's data. Also a run started
with "if(!fblock_start)", so after a hole the next data block became
the start of a run that was read in the hole's place: the data after a
hole came out shifted.

Start a run when it is empty (fblock_count == 0) and read a hole as
zeros, as the first block already does. Sparse files (Linux makes them,
e.g. mkfs.ext4 -d of a tree with sparse files) read correctly now.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sys/src/cmd/ext4srv/ext4.c | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/sys/src/cmd/ext4srv/ext4.c b/sys/src/cmd/ext4srv/ext4.c
index e588789a0..aa017d1df 100644
--- a/sys/src/cmd/ext4srv/ext4.c
+++ b/sys/src/cmd/ext4srv/ext4.c
@@ -1445,7 +1445,7 @@ int ext4_fread(ext4_file *file, void *buf, usize size, usize *rcnt)
 
 			iblock_idx++;
 
-			if (!fblock_start)
+			if (fblock_count == 0)
 				fblock_start = fblock;
 
 			if ((fblock_start + fblock_count) != fblock)
@@ -1454,7 +1454,11 @@ int ext4_fread(ext4_file *file, void *buf, usize size, usize *rcnt)
 			fblock_count++;
 		}
 
-		r = ext4_blocks_get_direct(file->mp->fs.bdev, u8_buf, fblock_start,
+		/* a hole (block 0) reads as zeros, not block 0 of the disk */
+		if (fblock_start == 0)
+			memset(u8_buf, 0, block_size * fblock_count);
+		else
+			r = ext4_blocks_get_direct(file->mp->fs.bdev, u8_buf, fblock_start,
 					   fblock_count);
 		if (r != 0)
 			goto Finish;
@@ -1477,7 +1481,10 @@ int ext4_fread(ext4_file *file, void *buf, usize size, usize *rcnt)
 			goto Finish;
 
 		off = fblock * block_size;
-		r = ext4_block_readbytes(file->mp->fs.bdev, off, u8_buf, size);
+		if (fblock == 0)
+			memset(u8_buf, 0, size);
+		else
+			r = ext4_block_readbytes(file->mp->fs.bdev, off, u8_buf, size);
 		if (r != 0)
 			goto Finish;
 
