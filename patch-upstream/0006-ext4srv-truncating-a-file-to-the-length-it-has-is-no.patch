From 44a44efc25a467a57bbb1983a5a8a4574bc58209 Mon Sep 17 00:00:00 2001
From: Stefan Hertenberger <erde74@gmail.com>
Date: Sat, 31 Oct 2026 10:35:28 +0100
Subject: [PATCH 06/27] ext4srv: truncating a file to the length it has is no
 error

ext4_ftruncate() refused any length not below the file's with "space
preallocation not supported", the same length too: a wstat of length 0
on an empty file failed (a program that sets a file's length to 0
before it writes it, such as cargo through Rust's File::set_len).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sys/src/cmd/ext4srv/ext4.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/sys/src/cmd/ext4srv/ext4.c b/sys/src/cmd/ext4srv/ext4.c
index 9cd937086..a52ebe6e5 100644
--- a/sys/src/cmd/ext4srv/ext4.c
+++ b/sys/src/cmd/ext4srv/ext4.c
@@ -1271,7 +1271,11 @@ static int ext4_ftruncate_no_lock(ext4_file *file, u64int size)
 
 	/*Sync file size*/
 	file->fsize = ext4_inode_get_size(&file->mp->fs.sb, ref.inode);
-	if (file->fsize <= size) {
+	if (file->fsize == size) {
+		r = 0;
+		goto Finish;
+	}
+	if (file->fsize < size) {
 		werrstr("space preallocation not supported");
 		r = -1;
 		goto Finish;
-- 
2.56.0

