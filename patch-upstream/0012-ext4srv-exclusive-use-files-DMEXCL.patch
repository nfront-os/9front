From 58442096a5880a759642f37b280077f6f943a4f6 Mon Sep 17 00:00:00 2001
From: Stefan Hertenberger <erde74@gmail.com>
Date: Sat, 31 Oct 2026 10:38:32 +0100
Subject: [PATCH 12/20] ext4srv: exclusive-use files (DMEXCL)

open(5): a file with DMEXCL can be open by one fid at a time; another
open (or create) fails. ext4srv ignored the bit: wstat dropped it and
locks built on it (programs that create a lock file with DMEXCL, such
as cargo and rustc on Plan 9 for their build directories) locked
nothing.

Keep the bit in the inode as EXT4_INODE_FLAG_UNRM (chattr's u, which
Linux does not use), the way DMTMP is kept as NODUMP; report it in stat
and in the qid (QTEXCL); set and clear it by create and wstat. ext4srv
keeps a list of the inodes with DMEXCL its fids have open: a second
open fails with "file is locked", the entry goes when the fid is
clunked. The lock is not broken after a time (open(5) allows a server
to): a 9P connection that goes away clunks its fids.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sys/src/cmd/ext4srv/ext4.c    |  4 +-
 sys/src/cmd/ext4srv/ext4srv.c | 89 +++++++++++++++++++++++++++++++++++
 2 files changed, 91 insertions(+), 2 deletions(-)

diff --git a/sys/src/cmd/ext4srv/ext4.c b/sys/src/cmd/ext4srv/ext4.c
index a52ebe6e5..bef22a23d 100644
--- a/sys/src/cmd/ext4srv/ext4.c
+++ b/sys/src/cmd/ext4srv/ext4.c
@@ -1838,9 +1838,9 @@ int ext4_mode_set(struct ext4_mountpoint *mp, const char *path, u32int mode, u32
 	orig_mode &= ~0xFFF;
 	orig_mode |= mode & 0xFFF;
 	ext4_inode_set_mode(&mp->fs.sb, inode_ref.inode, orig_mode);
-	iflags &= EXT4_INODE_FLAG_APPEND | EXT4_INODE_FLAG_NODUMP;
+	iflags &= EXT4_INODE_FLAG_APPEND | EXT4_INODE_FLAG_NODUMP | EXT4_INODE_FLAG_UNRM;
 	ext4_inode_set_flag(inode_ref.inode, iflags);
-	iflags ^= EXT4_INODE_FLAG_APPEND | EXT4_INODE_FLAG_NODUMP;
+	iflags ^= EXT4_INODE_FLAG_APPEND | EXT4_INODE_FLAG_NODUMP | EXT4_INODE_FLAG_UNRM;
 	ext4_inode_clear_flag(inode_ref.inode, iflags);
 
 	inode_ref.dirty = true;
diff --git a/sys/src/cmd/ext4srv/ext4srv.c b/sys/src/cmd/ext4srv/ext4srv.c
index 6f8bb0281..35c537865 100644
--- a/sys/src/cmd/ext4srv/ext4srv.c
+++ b/sys/src/cmd/ext4srv/ext4srv.c
@@ -46,6 +46,57 @@ qvers(u32int ino, struct ext4_inode *inode)
 		0x9e3779b9U * *vslot(ino);
 }
 
+/*
+ * exclusive-use files (DMEXCL), as open(5) has them: one open at a
+ * time, another open fails with "file is locked". Kept in the inode as
+ * EXT4_INODE_FLAG_UNRM (chattr's u, not used by Linux), as DMTMP is
+ * NODUMP. The opens are those of this ext4srv: a list of the inodes
+ * the fids have open, an entry goes when its fid is clunked. A lock is
+ * not broken after a time (open(5) allows it): a 9P connection that
+ * goes clunks its fids.
+ */
+#define EXCLFLAG EXT4_INODE_FLAG_UNRM
+static char Elocked[] = "file is locked";
+
+typedef struct Excl Excl;
+struct Excl {
+	Part *p;
+	u32int ino;
+	Excl *next;
+};
+static Excl *excls;
+
+static int
+exclopen(Part *p, u32int ino)
+{
+	Excl *e;
+
+	for(e = excls; e != nil; e = e->next)
+		if(e->p == p && e->ino == ino){
+			werrstr(Elocked);
+			return -1;
+		}
+	e = emalloc9p(sizeof(*e));
+	e->p = p;
+	e->ino = ino;
+	e->next = excls;
+	excls = e;
+	return 0;
+}
+
+static void
+exclclose(Part *p, u32int ino)
+{
+	Excl **l, *e;
+
+	for(l = &excls; (e = *l) != nil; l = &e->next)
+		if(e->p == p && e->ino == ino){
+			*l = e->next;
+			free(e);
+			return;
+		}
+}
+
 #define MIN(a,b) ((a)<(b)?(a):(b))
 
 int mainstacksize = 65536;
@@ -63,6 +114,7 @@ struct Aux {
 	};
 	int type;
 	bool rclose;
+	u32int exclino;	/* the DMEXCL file this fid has open */
 };
 
 enum {
@@ -206,6 +258,8 @@ static void
 ropen(Req *r)
 {
 	struct ext4_mountpoint *mp;
+	struct ext4_inode inode;
+	u32int ino;
 	char *path;
 	int res;
 	Aux *a;
@@ -248,6 +302,14 @@ ropen(Req *r)
 			respond(r, "double open");
 			return;
 		}
+		if(ext4_raw_inode_fill(mp, a->path, &ino, &inode) == 0 &&
+		    (ext4_inode_get_flags(&inode) & EXCLFLAG) != 0){
+			if(exclopen(a->p, ino) < 0){
+				responderror(r);
+				return;
+			}
+			a->exclino = ino;
+		}
 		if((a->file = malloc(sizeof(*a->file))) == nil)
 			goto Nomem;
 		if((path = estrdup9p(a->path)) == nil){
@@ -260,6 +322,10 @@ ropen(Req *r)
 		if(res != 0){
 			free(a->file);
 			a->file = nil;
+			if(a->exclino != 0){
+				exclclose(a->p, a->exclino);
+				a->exclino = 0;
+			}
 			responderror(r);
 			return;
 		}
@@ -269,6 +335,10 @@ ropen(Req *r)
 		break;
 
 Nomem:
+		if(a->type == Afile && a->exclino != 0){
+			exclclose(a->p, a->exclino);
+			a->exclino = 0;
+		}
 		respond(r, "memory");
 		return;
 	}
@@ -349,6 +419,12 @@ rcreate(Req *r)
 		iflags |= EXT4_INODE_FLAG_APPEND;
 	if(r->ifcall.perm & DMTMP)
 		iflags |= EXT4_INODE_FLAG_NODUMP;
+	if(!mkdir && (r->ifcall.perm & DMEXCL) != 0){
+		iflags |= EXCLFLAG;
+		if(exclopen(a->p, a->file->inode) < 0)
+			goto ext4errorrm;
+		a->exclino = a->file->inode;
+	}
 	if(ext4_mode_set(mp, s, perm, iflags) < 0)
 		goto ext4errorrm;
 	ext4_owner_set(mp, s, a->uid, a->uid);
@@ -361,6 +437,8 @@ rcreate(Req *r)
 	vbump(a->file->inode);
 	r->fid->qid.vers = tm + 0x9e3779b9U * *vslot(a->file->inode);
 	r->fid->qid.type = 0;
+	if(iflags & EXCLFLAG)
+		r->fid->qid.type |= QTEXCL;
 	r->ofcall.qid = r->fid->qid;
 
 	free(a->path);
@@ -425,6 +503,10 @@ dirfill(Dir *dir, Aux *a, char *path)
 		dir->qid.type |= QTTMP;
 		dir->mode |= DMTMP;
 	}
+	if(t != EXT4_INODE_MODE_DIRECTORY && (iflags & EXCLFLAG) != 0){
+		dir->qid.type |= QTEXCL;
+		dir->mode |= DMEXCL;
+	}
 
 	if(path != nil && (s = strrchr(path, '/')) != nil)
 		path = s+1;
@@ -736,6 +818,8 @@ rwstat(Req *r)
 			iflags |= EXT4_INODE_FLAG_APPEND;
 		if(r->d.mode & DMTMP)
 			iflags |= EXT4_INODE_FLAG_NODUMP;
+		if(r->d.mode & DMEXCL)
+			iflags |= EXCLFLAG;
 		if(ext4_mode_set(mp, a->path, r->d.mode & 0777, iflags) < 0)
 			goto error;
 	}
@@ -820,6 +904,8 @@ err:
 		qid->type |= QTAPPEND;
 	if(iflags & EXT4_INODE_FLAG_NODUMP)
 		qid->type |= QTTMP;
+	if(t != EXT4_INODE_MODE_DIRECTORY && (iflags & EXCLFLAG) != 0)
+		qid->type |= QTEXCL;
 	free(a->path);
 	a->path = s;
 	fid->qid = *qid;
@@ -841,6 +927,7 @@ rclone(Fid *oldfid, Fid *newfid)
 	c->file = nil;
 	c->dir = nil;
 	c->rclose = false;
+	c->exclino = 0;
 
 	incref(c->p);
 	newfid->aux = c;
@@ -867,6 +954,8 @@ rdestroyfid(Fid *fid)
 		if(a->rclose)
 			ext4_fremove(&a->p->mp, a->path);
 	}
+	if(a->exclino != 0)
+		exclclose(a->p, a->exclino);
 
 	if(decref(a->p) < 1)
 		closepart(a->p);
-- 
2.56.0

