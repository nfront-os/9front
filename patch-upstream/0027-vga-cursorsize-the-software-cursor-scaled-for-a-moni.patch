From edaf0ee0e9bb6508e029306acaa776587258cc71 Mon Sep 17 00:00:00 2001
From: Stefan Hertenberger <erde74@gmail.com>
Date: Thu, 12 Nov 2026 09:40:11 +0100
Subject: [PATCH 27/27] vga: cursorsize, the software cursor scaled for a
 monitor with many pixels to the inch

vgactl's cursorsize n draws the software cursor n pixels big (16 to
64): its 16x16 picture scaled, each pixel the nearest, and its offset
with it.  On a screen of 200 dpi the 16 pixel arrow is hard to see;
echo cursorsize 32 >/dev/vgactl doubles it.  Reading vgactl gives the
size.  Hardware cursors stay 16x16.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sys/man/3/vga             | 11 +++++++++
 sys/src/9/pc/devvga.c     | 19 +++++++++++++++
 sys/src/9/pc/screen.h     |  1 +
 sys/src/9/port/swcursor.c | 51 ++++++++++++++++++++++++++++++++++++---
 4 files changed, 78 insertions(+), 4 deletions(-)

diff --git a/sys/man/3/vga b/sys/man/3/vga
index 993f9767b..4e167169a 100644
--- a/sys/man/3/vga
+++ b/sys/man/3/vga
@@ -156,6 +156,17 @@ used by the graphics engine.
 The default setting is
 .BR on .
 .TP
+.BI cursorsize " n"
+draws the software cursor
+.I n
+pixels big (16 to 64; 16 at first): its 16×16 picture scaled, each pixel
+the nearest, and its offset with it, for a monitor with many pixels to
+the inch.
+Hardware cursors stay 16×16.
+Reading
+.B vgactl
+gives the size.
+.TP
 .BI softscreen " mode"
 Depending on whether
 .I mode
diff --git a/sys/src/9/pc/devvga.c b/sys/src/9/pc/devvga.c
index 8b592574b..b9342f36f 100644
--- a/sys/src/9/pc/devvga.c
+++ b/sys/src/9/pc/devvga.c
@@ -38,6 +38,7 @@ enum {
 	CMtextmode,
 	CMtype,
 	CMsoftscreen,
+	CMcursorsize,
 	CMpcidev,
 	CMtilt,
 };
@@ -54,6 +55,7 @@ static Cmdtab vgactlmsg[] = {
 	CMtextmode,	"textmode",	1,
 	CMtype,		"type",		2,
 	CMsoftscreen,	"softscreen",	2,
+	CMcursorsize,	"cursorsize",	2,
 	CMpcidev,	"pcidev",	2,
 	CMtilt,		"tilt",		2,
 };
@@ -166,6 +168,7 @@ vgaread(Chan* c, void* a, long n, vlong off)
 		p = seprint(p, e, "addr p 0x%.8llux v %#p size %#ux\n",
 			scr->paddr, scr->vaddr, scr->apsize);
 		p = seprint(p, e, "softscreen %s\n", scr->softscreen ? "on" : "off");
+		p = seprint(p, e, "cursorsize %d\n", swcursorsize(0));
 		USED(p);
 		n = readstr(offset, a, n, s);
 		poperror();
@@ -195,6 +198,22 @@ vgactl(VGAscr *scr, Cmdbuf *cb)
 
 	ct = lookupcmd(cb, vgactlmsg, nelem(vgactlmsg));
 	switch(ct->index){
+	case CMcursorsize:
+		/* the software cursor n pixels big */
+		if(scr->gscreen == nil)
+			error(Enoscreen);
+		qlock(&drawlock);
+		if(waserror()){
+			qunlock(&drawlock);
+			nexterror();
+		}
+		cursoroff();
+		swcursorsize(strtol(cb->f[1], nil, 0));
+		cursoron();
+		poperror();
+		qunlock(&drawlock);
+		return;
+
 	case CMhwgc:
 		if(scr->gscreen == nil)
 			error(Enoscreen);
diff --git a/sys/src/9/pc/screen.h b/sys/src/9/pc/screen.h
index 088bbc3b0..0f7e2130d 100644
--- a/sys/src/9/pc/screen.h
+++ b/sys/src/9/pc/screen.h
@@ -172,3 +172,4 @@ void		swcursoravoid(Rectangle);
 void		swcursordraw(Point);
 void		swcursorload(Cursor *);
 void		swcursorinit(void);
+int		swcursorsize(int);
diff --git a/sys/src/9/port/swcursor.c b/sys/src/9/port/swcursor.c
index 8161728e8..5bc3ae913 100644
--- a/sys/src/9/port/swcursor.c
+++ b/sys/src/9/port/swcursor.c
@@ -12,6 +12,7 @@
 #include	"screen.h"
 
 extern Memimage* gscreen;
+extern Cursor cursor;	/* devmouse.c's: the cursor now */
 
 /*
  * Software cursor. 
@@ -21,6 +22,9 @@ static Memimage*	swimg;		/* cursor image */
 static Memimage*	swmask;		/* cursor mask */
 static Memimage*	swimg1;
 static Memimage*	swmask1;
+static Memimage*	swimgn;		/* the cursor image and mask at swsize */
+static Memimage*	swmaskn;
+static int		swsize = 16;	/* as big as this on the screen (cursorsize) */
 
 static Point		swoffset;
 static Rectangle	swrect;		/* screen rectangle in swback */
@@ -103,10 +107,45 @@ swcursorload(Cursor *curs)
 		}
 	}
 	swoffset = curs->offset;
+	if(swsize != 16 && swimgn != nil && swmaskn != nil){
+		/*
+		 * as big as swsize, each pixel the nearest of the 16×16
+		 * (a window system drawing at a scale, wsys' HiDPI)
+		 */
+		ip = byteaddr(swimgn, ZP);
+		mp = byteaddr(swmaskn, ZP);
+		for(i=0; i<swsize; i++)
+			for(j=0; j<swsize; j++){
+				*ip++ = byteaddr(swimg, Pt(j*16/swsize, i*16/swsize))[0];
+				*mp++ = byteaddr(swmask, Pt(j*16/swsize, i*16/swsize))[0];
+			}
+		swoffset = Pt(curs->offset.x*swsize/16, curs->offset.y*swsize/16);
+		memimagedraw(swimg1, swimg1->r, swimgn, ZP, memopaque, ZP, S);
+		memimagedraw(swmask1, swmask1->r, swmaskn, ZP, memopaque, ZP, S);
+		return;
+	}
 	memimagedraw(swimg1, swimg1->r, swimg, ZP, memopaque, ZP, S);
 	memimagedraw(swmask1, swmask1->r, swmask, ZP, memopaque, ZP, S);
 }
 
+/*
+ * the cursor n pixels big (16 to 64; vgactl's cursorsize): its 16×16
+ * scaled, for a window system that draws at a scale; called with
+ * drawlock held and the cursor off.  0: only the size now
+ */
+int
+swcursorsize(int n)
+{
+	if(n == 0)
+		return swsize;
+	if(n < 16 || n > 64)
+		error(Ebadarg);
+	swsize = n;
+	swcursorinit();
+	swcursorload(&cursor);
+	return swsize;
+}
+
 void
 swcursorinit(void)
 {
@@ -120,13 +159,17 @@ swcursorinit(void)
 		freememimage(swmask1);
 		freememimage(swimg);
 		freememimage(swimg1); 
+		freememimage(swimgn);
+		freememimage(swmaskn);
 	}
-	swback = allocmemimage(Rect(0,0,16,16), gscreen->chan);
+	swback = allocmemimage(Rect(0,0,swsize,swsize), gscreen->chan);
 	swmask = allocmemimage(Rect(0,0,16,16), GREY8);
-	swmask1 = allocmemimage(Rect(0,0,16,16), GREY1);
+	swmask1 = allocmemimage(Rect(0,0,swsize,swsize), GREY1);
 	swimg = allocmemimage(Rect(0,0,16,16), GREY8);
-	swimg1 = allocmemimage(Rect(0,0,16,16), GREY1);
-	if(swback == nil || swmask == nil || swmask1 == nil || swimg == nil || swimg1 == nil){
+	swimg1 = allocmemimage(Rect(0,0,swsize,swsize), GREY1);
+	swimgn = allocmemimage(Rect(0,0,swsize,swsize), GREY8);
+	swmaskn = allocmemimage(Rect(0,0,swsize,swsize), GREY8);
+	if(swback == nil || swmask == nil || swmask1 == nil || swimg == nil || swimg1 == nil || swimgn == nil || swmaskn == nil){
 		print("software cursor: allocmemimage fails\n");
 		return;
 	}
-- 
