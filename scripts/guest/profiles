ui	$objtype/bin/wbar
ui	$objtype/bin/wdock
ui	$objtype/bin/wlsys
ui	$objtype/bin/wsys
ui	$objtype/bin/ape/ptyfs
ui	$objtype/lib.gcc/libui.a
ui	$objtype/lib.gcc/ape/libdevdraw.a
ui	$objtype/lib.gcc/ape/libexpat.a
ui	$objtype/lib.gcc/ape/libfcft.a
ui	$objtype/lib.gcc/ape/libffi.a
