#!/bin/rc
# gen-9syscall.sh: libc's (--ape: APE's) system call stubs, GAS .S
# beside 9syscall's .s, from sys.h; the stubs and their names are
# described in scripts/build/gen-9syscall.sh
#	gen-9syscall.rc [--ape] [dir]
. $PLAN9/scripts/build/rc/lib.rc
ape=()
if(~ $1 --ape){
	ape=1
	shift
}
SYSH=$PLAN9/sys/src/libc/9syscall/sys.h
D=$1
if(~ $#D 0){
	if(~ $#ape 1)
		D=$PLAN9/sys/src/ape/lib/ap/syscall
	if not
		D=$PLAN9/sys/src/libc/9syscall
}
cd $D || die no $D
rm -f *.s *.S
if(~ $#ape 1)
	SYS=`{sed '/^#define._/d; s/#define.([A-Z0-9_]*).*/\1/' $SYSH}
if not
	SYS=`{sed '/^#define._X[123]/d; s/#define.([A-Z0-9_]*).*/\1/' $SYSH}
for(I in $SYS){
	n=`{awk '$1 == "#define" && $2 == "'$I'" { print $3 }' $SYSH}
	if(~ $#ape 1){
		i=_$I
		j=$i
		if(~ $i _SEEK)
			j=__SEEK
		if(~ $objtype^$i amd64_NOTIFY arm64_NOTIFY)
			j=__NOTIFY
	}
	if not{
		i=`{echo $I | tr A-Z a-z}
		if(~ $i exits nsec)
			i=_$i
		j=$i
		if(~ $i seek)
			j=_seek
		if(~ $objtype^$i amd64notify arm64notify)
			j=_notify
	}
	switch($objtype){
	case 386
		{
			echo '/* generated by scripts/build/gen-9syscall.sh from sys.h */'
			echo '.globl	'$j
			echo $j':'
			echo '	movl	$'$n', %eax'
			echo '	int	$64'
			if(~ $I SEEK _NSEC NSEC){
				echo '	cmpl	$-1, %eax'
				echo '	jne	1f'
				echo '	movl	4(%esp), %ecx'
				echo '	movl	%eax, 0(%ecx)'
				echo '	movl	%eax, 4(%ecx)'
				echo '1:'
			}
			echo '	ret'
		} >$i.S
	case amd64
		{
			echo '/* generated by scripts/build/gen-9syscall.sh from sys.h */'
			echo '.globl	'$j
			echo $j':'
			echo '	subq	$80, %rsp'
			echo '	movq	%rbp, 0(%rsp)'
			echo '	movq	%rbx, 56(%rsp)'
			echo '	movq	%r12, 64(%rsp)'
			echo '	movq	%r13, 72(%rsp)'
			echo '	movq	%rdi, 8(%rsp)'
			echo '	movq	%rsi, 16(%rsp)'
			echo '	movq	%rdx, 24(%rsp)'
			echo '	movq	%rcx, 32(%rsp)'
			echo '	movq	%r8, 40(%rsp)'
			echo '	movq	%r9, 48(%rsp)'
			echo '	movq	$'$n', %rbp'
			echo '	syscall'
			echo '	movq	72(%rsp), %r13'
			echo '	movq	64(%rsp), %r12'
			echo '	movq	56(%rsp), %rbx'
			echo '	movq	0(%rsp), %rbp'
			echo '	addq	$80, %rsp'
			echo '	ret'
		} >$i.S
	case *
		die no stubs for 'objtype='$objtype
	}
}
ls *.S | wc -l
exit ''
