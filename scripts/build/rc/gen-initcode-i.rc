#!/bin/rc
# gen-initcode-i.sh: the kernel's initcode (sys/src/9/port/initcode.i),
# preceded by room for the a.out header proc0() skips
. $PLAN9/scripts/build/rc/lib.rc
switch($objtype){
case amd64
	TEXT=0x200028	# UTZERO 0x200000 + 6l's 0x28 byte header
	HDR=40
	CC=($GNU/gcc '-mcmodel=small')
	LD=$GNU/ld
	INIT9=pc64/init9.S
case 386
	# 8l: pc/init9.c as it is, header of 32 bytes (touser: UTZERO+32)
	TEXT=0x1020	# UTZERO 0x1000 + 0x20
	HDR=32
	CC=($GNU/gcc -m32 '-march=pentium' -mno-sse)
	LD=$GNU/ld
	INIT9=pc/init9.c
case *
	die 'objtype='$objtype not done
}
CFLAGS=('-std=gnu17' -fno-asm -ffreestanding -nostdinc -fno-builtin -fplan9-extensions \
	-fno-omit-frame-pointer -fno-stack-protector -fno-pie -Os \
	-I$PLAN9/$objtype/include -I$PLAN9/sys/include)
$CC $CFLAGS -c -o $TMP/init9.o $PLAN9/sys/src/9/$INIT9 || die init9
$CC $CFLAGS -c -o $TMP/initcode.o $PLAN9/sys/src/9/port/initcode.c || die initcode
libgcc=()
test -f $PLAN9/$objtype/lib.gcc/libgcc.a && libgcc=$PLAN9/$objtype/lib.gcc/libgcc.a
$LD -N -static -Ttext'='$TEXT --entry'='_main -o $TMP/initcode.elf \
	$TMP/init9.o $TMP/initcode.o $PLAN9/$objtype/lib.gcc/libc.a $libgcc || die ld
$GNU/objcopy -O binary -R .bss -R .comment -R .note.gnu.property $TMP/initcode.elf $TMP/initcode.bin || die objcopy
n=`{ls -l $TMP/initcode.bin | awk '{print $6}'}
n=`{echo $n + $HDR | hoc}
if(test $n -gt 4096)
	die initcode: $n bytes, more than one page
{
	echo '/* generated by scripts/build/gen-initcode-i.sh from port/initcode.c, '$INIT9' */'
	echo 'uchar initcode[] = {'
	bin2c $TMP/initcode.bin $HDR
	echo '};'
} >$PLAN9/sys/src/9/port/initcode.i
echo initcode: $n bytes
exit ''
