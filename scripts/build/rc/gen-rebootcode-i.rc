#!/bin/rc
# gen-rebootcode-i.sh: the kernel's rebootcode.i, linked at REBOOTADDR
# (pc: gen-rebootcode-pc-i.sh)
#	gen-rebootcode-i.rc [pc64|pc]
. $PLAN9/scripts/build/rc/lib.rc
k=$1
~ $#k 0 && k=pc64
switch($k){
case pc64
	KDIR=$PLAN9/sys/src/9/pc64
	REBOOTADDR=0x11000
	ENTRY=main
	CFLAGS=(-m64 -mno-red-zone)
	GEN=gen-rebootcode-i.sh
case pc
	KDIR=$PLAN9/sys/src/9/pc
	REBOOTADDR=0x11000
	ENTRY=main
	CFLAGS=-m32
	GEN=gen-rebootcode-pc-i.sh
case *
	die $k not done
}
$GNU/gcc $CFLAGS -c '-std=c11' -fno-pic -fno-pie -I$KDIR -I$KDIR/../port \
	-I$PLAN9/sys/include $KDIR/rebootcode.S -o $TMP/rebootcode.o || die cc
$GNU/ld -static -Ttext'='$REBOOTADDR --entry'='$ENTRY -N -o $TMP/rebootcode.elf $TMP/rebootcode.o || die ld
$GNU/objcopy -O binary --only-section'='.text $TMP/rebootcode.elf $TMP/rebootcode.bin || die objcopy
{
	echo '/*'
	echo ' * Generated by scripts/build/'$GEN' from rebootcode.S,'
	echo ' * linked at REBOOTADDR ('$REBOOTADDR'). Do not hand-edit.'
	echo ' */'
	echo 'static uchar rebootcode[] = {'
	bin2c $TMP/rebootcode.bin 0
	echo '};'
} >$KDIR/rebootcode.i
echo wrote `{ls -l $TMP/rebootcode.bin | awk '{print $6}'} bytes to $KDIR/rebootcode.i
exit ''
