#!/bin/rc
# cargo.sh on 9front: a Rust crate of the tree built with the native cargo and rustc
# of ../9front-rust (/$cputype/rust, scripts/install.sh there), linked by the native
# gcc (/$cputype/gnu), its programs installed in /$objtype/bin. Without them it says
# so and builds nothing (check-install.rc reports the programs as norust).
#	cargo.rc dir prog...
. $PLAN9/scripts/build/rc/lib.rc
if(~ $#* 0 1)
	die usage: cargo.rc dir prog...
rust=/$cputype/rust/bin
if(! test -x $rust/cargo || ! test -x $rust/rustc || ! test -x $GNU/gcc){
	echo cargo.rc: no Rust toolchain '('$rust, $GNU')': $* not built >[1=2]
	exit ''
}
dir=$1
shift
bind -b $rust /bin
bind -b $GNU /bin
target=/tmp/cargo.`{echo $dir | sed 's,/,_,g'}
# a member of a workspace (workspace = "..." in its Cargo.toml) is built there, as its package
ws=`{sed -n 's/^workspace *= *"(.*)"/\1/p' $PLAN9/$dir/Cargo.toml}
pkg=()
if(! ~ $#ws 0)
	pkg=(-p `{sed -n 's/^name *= *"(.*)"/\1/p' $PLAN9/$dir/Cargo.toml | sed 1q})
# cargo does not know the C libraries it links (libvulkan.a, APE's, lib9's):
# a program older than one of them goes (release/p and the deps/p-hash it is
# a link of: cargo looks at that one), so that cargo links it again
for(p in $*){
	bin=$target/release/$p
	if(test -e $bin){
		for(a in `{walk -f $PLAN9/$objtype/lib.gcc | grep '\.a$'})
			if(test -e $bin && test $a -nt $bin)
				rm -f $bin $target/release/deps/$p-*
	}
}
@{
	cd $PLAN9/$dir || die no $dir
	if(! ~ $#ws 0)
		cd $ws || die no workspace $ws
	CARGO_TARGET_DIR=$target cargo build --offline --release --quiet $pkg
} || die cargo build $dir
mkdir -p $PLAN9/$objtype/bin
for(p in $*){
	if(! cmp -s $target/release/$p $PLAN9/$objtype/bin/$p){
		cp $target/release/$p $PLAN9/$objtype/bin/$p.new && mv $PLAN9/$objtype/bin/$p.new $PLAN9/$objtype/bin/$p || die install $p
	}
}
exit ''
