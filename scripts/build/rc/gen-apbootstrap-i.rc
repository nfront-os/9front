#!/bin/rc
# gen-apbootstrap-i.sh: the kernel's apbootstrap.i, linked at
# APBOOTSTRAP (KZERO+0x7000)
#	gen-apbootstrap-i.rc [pc64]
. $PLAN9/scripts/build/rc/lib.rc
k=$1
~ $#k 0 && k=pc64
switch($k){
case pc64
	KDIR=$PLAN9/sys/src/9/pc64
	APBOOTSTRAP=0xffffffff80007000
	CFLAGS=(-m64 -mno-red-zone)
case *
	die $k not done
}
$GNU/gcc -c '-std=c11' $CFLAGS -fno-pic -fno-pie -I$KDIR -I$KDIR/../port -I$PLAN9/sys/include \
	$KDIR/apbootstrap.S -o $TMP/apbootstrap.o || die cc
$GNU/ld -static -Ttext'='$APBOOTSTRAP --entry'='apbootstrap -N -o $TMP/apbootstrap.elf $TMP/apbootstrap.o || die ld
$GNU/objcopy -O binary --only-section'='.text $TMP/apbootstrap.elf $TMP/apbootstrap.bin || die objcopy
{
	echo '/*'
	echo ' * Generated by scripts/build/gen-apbootstrap-i.sh from apbootstrap.S,'
	echo ' * linked at APBOOTSTRAP (KZERO+0x7000). Do not hand-edit.'
	echo ' */'
	echo 'static uchar apbootstrap[] = {'
	bin2c $TMP/apbootstrap.bin 0
	echo '};'
} >$KDIR/apbootstrap.i
echo wrote `{ls -l $TMP/apbootstrap.bin | awk '{print $6}'} bytes to $KDIR/apbootstrap.i
exit ''
