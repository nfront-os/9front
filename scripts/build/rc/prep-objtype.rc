#!/bin/rc
# prep-objtype.sh: the install directories the manifests expect, and
# gcc's libgcc.a (amd64: for the Linux drivers, sys/src/linux)
. $PLAN9/scripts/build/rc/lib.rc
cd $PLAN9
mkdir -p $objtype/bin/aux $objtype/lib.gcc
switch($objtype){
case 386 arm64 amd64
	# only when it differs: every program links it (build.exe -D)
	f=`{$GNU/gcc -print-libgcc-file-name}
	if(! cmp -s $f $objtype/lib.gcc/libgcc.a)
		cp $f $objtype/lib.gcc/libgcc.a || die libgcc.a
}
exit ''
# POSIX's names of libraries whose functions are all in libap: empty archives
mkdir -p $objtype/lib.gcc/ape
for(l in m pthread rt dl)
	if(! test -f $objtype/lib.gcc/ape/lib$l.a)
		echo '!<arch>' > $objtype/lib.gcc/ape/lib$l.a
