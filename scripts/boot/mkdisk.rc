#!/bin/rc
# Install the 9front distribution onto the disk sdC0, run inside the
# guest by scripts/mkdisk.sh: sys/lib/dist/mkfile's recipe for
# %.amd64.qcow2 (%.disk) with this port's tools, the distribution tree
# served by the build host as /n/src9 (scripts/stage-dist.sh).
#
# Deviations (GCC port): the 16-bit boot code 9front puts on the disk
# (/386/mbr, /386/pbs, /386/9bootfat) is not ported; the build host puts
# GRUB in the MBR and the gap before the first partition instead. So the
# plan9 partition starts at the second cylinder (fdisk commands as the
# mkfile's reform/pi targets use) rather than fdisk -baw's first track,
# and 9fat gets no boot sector code, only plan9.ini and the kernel.
rfork en
fn fail{
	echo mkdisk: failed: $*
	exit failed
}

d=/dev/sdC0
s=newfs
proto=/n/src9/sys/lib/sysconfig/proto/distproto
bootproto=/n/src9/sys/lib/sysconfig/proto/9bootproto
gccproto=/n/src9/gccproto	# /amd64/lib.gcc (scripts/boot/gccproto)
kernel=/n/src9/amd64/9pc64

test -f $d/data || fail no disk $d
if(! test -d /n/src9/amd64)
	srv tcp!10.0.2.101!5641 src9 && mount -nc /srv/src9 /n/src9 || fail mount src9

> /env/plan9.ini {
	echo 'bootfile='^`{basename $kernel}
	echo 'console=0'
}
fatfiles=(/env/plan9.ini $kernel)

disk/mbr $d/data || fail mbr
{
	echo 'a p1 1 $'	# fdisk counts in cylinders: start at the second one
	echo 't p1 PLAN9'
	echo 'A p1'
	echo 'w'
	echo 'q'
} | disk/fdisk -b $d/data || fail fdisk
disk/prep -bw -a^(9fat nvram fs) $d/plan9 || fail prep
disk/format -d -r 2 $d/9fat $fatfiles || fail format
hjfs -f $d/fs -n $s -S -r || fail hjfs
{
	echo echo on
	echo create /dist sys sys 775 d
	echo create /usr sys sys 775 d
	user=glenda
	echo newuser $user
	echo newuser adm +$user
	echo newuser sys +$user
	echo newuser upas +$user
	echo echo off
	sleep 1
} >> /srv/$s.cmd
mount -N -c /srv/$s /n/newfs || fail mount newfs
disk/mkfs -z 4096 -U -s /n/src9 -d /n/newfs <{cat $proto $bootproto $gccproto}	# warns about the missing /386 boot code
echo sync >> /srv/$s.cmd
echo halt >> /srv/$s.cmd
while(test -e /srv/$s.cmd) sleep 1
echo mkdisk: done
