#!/bin/rc
# run by wsys -d -x -i with WSYSDEBUG=draw (tests/draw): drawing as a desktop
# does it, for wsys' own devdraw to count (hwdraw's classes, its time): text
# written into a text window (it scrolls), a draw(3) program (clock), a window
# that moves itself (its layer's pixels copied), rio in a window of wsys with
# a window of its own writing text
window -r 0 0 640 400 /tests/wltext
window -r 660 0 960 240 clock
window -r 100 420 500 700 /tests/wlmove
window -r 520 260 1000 740 rio -i /tests/wlrio
sleep 10
