#!/bin/rc
# vktri in its window of wsys for 3 seconds, the log to $1; with copy:
# the frames through draw(3) as before (WSI_PLAN9_COPY=1)
log=$1
if(~ $2 copy)
	WSI_PLAN9_COPY=1
if(~ $2 norebuild)
	VKTRI_NOREBUILD=1	# as many apps: VK_SUBOPTIMAL_KHR ignored
WSI_PLAN9_STATS=1 /tests/vktri 3 >>$log >[2=1]
echo wsysvk: exit $status >>$log
