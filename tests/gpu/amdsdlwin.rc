#!/bin/rc
# run by wsys -x -i (amdsdl.rc): sdlvk in a window of wsys; with overlay, its
# frames on the overlay plane (not in wsys' screen: sdlvk -W), the driver's
# status while it runs
rm -f /tmp/svk.log
flag=()
label=wsys
frames=60
if(~ $1 overlay){
	flag=-W
	label=overlay
	frames=180	# 3 s at the display's rate: the status is read while it runs
}
window -r 100 100 500 400 'rc -c ''/tests/sdlvk '$"flag' '$frames' >/tmp/svk.log >[2=1]; echo sdlvk: exit $status >>/tmp/svk.log'''
if(~ $1 overlay){
	sleep 1
	grep '^overlay' /dev/gpu/0/status | sed 's/^/during: /'
}
n=0
while(! grep -s '^sdlvk: exit' /tmp/svk.log && test $n -lt 600){ sleep 0.1; n=`{echo $n+1 | hoc} }
sed 's/^/'$label'sdl: /' /tmp/svk.log
