#!/bin/rc
# run by wsys -x -i (tests/gpu/run.sh): vktri in a window of wsys, whose
# frames go to wsys as GPU buffers (gpu(4) export, wsys' gpubuffer), then
# again by copy (WSI_PLAN9_COPY=1); eframetest (egui's eframe) on wgpu's
# Vulkan: with a GPU it must not fall back to the processor; ui (vello on
# wgpu); the logs at the end.  WSI_PLAN9_STATS=1: each says which way its
# frames go (wsys: GPU buffers; copy: through draw(3)), run.sh wants wsys
rm -f /tmp/wvk.log /tmp/wvkcopy.log /tmp/eframe.log
fn waitexit { # log
	n=0
	while(! grep -s '^wsysvk: exit' $1 && test $n -lt 600){ sleep 0.1; n=`{echo $n+1 | hoc} }
}
window -r 100 100 740 580 /tests/wsysvktri /tmp/wvk.log
waitexit /tmp/wvk.log
window -r 100 100 740 580 /tests/wsysvktri /tmp/wvkcopy.log copy
waitexit /tmp/wvkcopy.log
if(test -x /tests/eframetest){
	window -r 100 100 600 450 'rc -c ''WSI_PLAN9_STATS=1 /tests/eframetest -r wgpu >/tmp/eframe.log >[2=1]; echo eframetest: exit $status >>/tmp/eframe.log'''
	n=0
	while(! grep -s '^eframetest: exit' /tmp/eframe.log && test $n -lt 900){ sleep 0.1; n=`{echo $n+1 | hoc} }
}
# SDL3 on Vulkan: its renderer (sdlvk), its GPU API (sdlgpu)
rm -f /tmp/sdlvk.log /tmp/sdlgpu.log
for(p in sdlvk sdlgpu) if(test -x /tests/$p){
	window -r 100 100 500 400 'rc -c ''WSI_PLAN9_STATS=1 /tests/'$p' 60 >/tmp/'$p'.log >[2=1]; echo '$p': exit $status >>/tmp/'$p'.log'''
	n=0
	while(! grep -s '^'$p': exit' /tmp/$p.log && test $n -lt 600){ sleep 0.1; n=`{echo $n+1 | hoc} }
}
# ui (ui(4)) on the GPU: its renderer, a button laid out after a frame
if(test -x /tests/ui){
	window -r 100 100 600 450 'rc -c ''WSI_PLAN9_STATS=1 /tests/ui -s uivk >/tmp/uivk.log >[2=1]'''
	n=0
	while(! test -e /srv/uivk && test $n -lt 100){ sleep 0.1; n=`{echo $n+1 | hoc} }
	mount /srv/uivk /mnt/ui
	echo 'new b button
set b text press me' >/mnt/ui/ctl
	n=0
	while(~ `{cat /mnt/ui/nodes/b/rect} () && test $n -lt 300){ sleep 0.1; n=`{echo $n+1 | hoc} }
	r=`{cat /mnt/ui/renderer}
	echo ui: renderer $"r
	echo ui: rect `{cat /mnt/ui/nodes/b/rect}
	grep 'render' /tmp/uivk.log | sed 's/^/ui: log /'
	grep '^wsi plan9: [^ ]*: ' /tmp/uivk.log | sed 's/^/ui: /'
	unmount /mnt/ui
}
sed 's/^/gpu: /' /tmp/wvk.log
sed 's/^/copy: /' /tmp/wvkcopy.log
if(test -e /tmp/eframe.log)
	sed 's/^/eframe: /' /tmp/eframe.log
for(p in sdlvk sdlgpu) if(test -e /tmp/$p.log)
	sed 's/^/'$p': /' /tmp/$p.log
