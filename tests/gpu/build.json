[
	{
		"Name": "gpu-tests",
		"Include": [
			"/$ARCH/cflags.json"
		],
		"Install": "/tests/gpu/root/tests/",
		"Oflags": [
			"--entry=_main"
		],
		"Libs": [
			"--start-group",
			"/$ARCH/lib.gcc/libdraw.a",
			"/$ARCH/lib.gcc/libbio.a",
			"/$ARCH/lib.gcc/libc.a",
			"--end-group"
		],
		"SourceFilesCmd": [
			"gputest.c",
			"gpuctxtest.c",
			"segrevoke.c"
		]
	},
	{
		"Name": "gpu-tests-draw",
		"Include": [
			"/$ARCH/cflags.json"
		],
		"Install": "/tests/gpu/root/tests/",
		"Oflags": [
			"--entry=_main"
		],
		"Libs": [
			"--start-group",
			"/$ARCH/lib.gcc/libdraw.a",
			"/$ARCH/lib.gcc/libc.a",
			"--end-group"
		],
		"SourceFilesCmd": [
			"drawspeed.c",
			"screenpx.c"
		]
	}
]
