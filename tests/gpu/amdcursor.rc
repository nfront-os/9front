#!/bin/rc
# aux/amdgpu's mouse cursor on the display (vga hwgc gpu): the pointer
# moved over the screen through /dev/mousein (absolute), 8 steps 1.2 s
# each; look at the monitor.  What each output's cursor plane holds
# after each step (gpu(4) status), the log's warnings.
bind -a '#i' /dev
bind -a '#v' /dev
bind -a '#m' /dev
aux/amdgpu $* >/tmp/amd.log >[2=1]
sleep 2
grep hwgc /dev/vgactl
for(p in '100 100' '960 540' '1800 100' '1800 1000' '100 1000' '1919 1079' '0 0' '960 540'){
	echo A $p 0 >/dev/mousein
	sleep 1.2
	echo moved to $p: `{grep '^output .* connected' /dev/gpu/0/status | sed 's/^output ([^ ]+) connected/\1/'}
}
grep hwgc /dev/vgactl
# HiDPI: the cursor 32 pixels big (vgactl cursorsize, as wsys -S 2 sets it):
# the driver draws it scaled on its cursor plane; then 16 again
echo cursorsize 32 >/dev/vgactl
sleep 1
echo size 32: `{grep '^cursorsize' /dev/vgactl} `{grep '^output .* connected' /dev/gpu/0/status | sed 's/^output ([^ ]+) connected/\1/'}
echo cursorsize 16 >/dev/vgactl
sleep 1
echo size 16: `{grep '^cursorsize' /dev/vgactl} `{grep '^output .* connected' /dev/gpu/0/status | sed 's/^output ([^ ]+) connected/\1/'}
grep 'cursor|WARN|error|fault' /tmp/amd.log
echo TESTEND
