#!/bin/rc
# run by wsys -x -i (amdwsys.rc; wsysovl comp: wsys composing on the GPU): vktri
# in a window of wsys on the overlay plane
# (gpu(4) overlay): wsys copies nothing, the display shows the GPU buffer; the
# driver's status while it runs, the frames (the display's rate: FIFO at the
# plane's vblank); what wsys said about the overlay.  The WSI starts with
# buffers wsys reads (copied into VRAM for the plane: variant a), makes them
# in VRAM when wsys says "overlay 1" (shown as they are: variant b), and
# buffers wsys reads again when another window covers it ("overlay 0"):
# then vktri's pixels are in wsys' screen again
# comp (wsys composing on the GPU): vktri's pixels from /dev/screen, devdraw's
# window has not got them
peek=()
if(~ $1 comp)
	peek=screen
rm -f /tmp/wvo.log
window -r 100 100 740 580 /tests/wsysvktri /tmp/wvo.log $peek
sleep 2
grep '^overlay' /dev/gpu/0/status | sed 's/^/during: /'
# wsys goes on while the display waits (the overlay's thread): 50 requests' time
t0=`{awk '{print $2}' /dev/time}
for(i in `{seq 1 50}) ls /mnt/wsys >/dev/null
t1=`{awk '{print $2}' /dev/time}
echo during: 50 ls of /mnt/wsys in `{echo '('$t1-$t0')/1000000' | hoc} ms
# another window over a corner of it (not where vktri reads its pixels):
# off the plane, the WSI makes buffers wsys reads again
window -r 600 500 900 700 sleep 5
sleep 1
grep '^overlay' /dev/gpu/0/status | sed 's/^/covered: /'
n=0
while(! grep -s '^wsysvk: exit' /tmp/wvo.log && test $n -lt 600){ sleep 0.1; n=`{echo $n+1 | hoc} }
sleep 1
grep '^overlay' /dev/gpu/0/status | sed 's/^/after: /'
grep 'frames|wsys has|wsys says|swapchain|screen at|passed|FAIL|exit' /tmp/wvo.log | sed 's/^/overlay: /'
# again, vktri ignoring VK_SUBOPTIMAL_KHR (as many apps): covered, its images
# in VRAM, the WSI must say out of date (vktri: "window changed size")
rm -f /tmp/wvo.log
window -r 100 100 740 580 /tests/wsysvktri /tmp/wvo.log norebuild
sleep 2
window -r 600 500 900 700 sleep 4
n=0
while(! grep -s '^wsysvk: exit' /tmp/wvo.log && test $n -lt 600){ sleep 0.1; n=`{echo $n+1 | hoc} }
grep 'wsys says|out of date|changed size|exit' /tmp/wvo.log | sed 's/^/norebuild: /'

# on the overlay plane uncovered, its pixels read from wsys' screen
# (/dev/screen): devdraw's screen has not got them, wsys puts in what the
# plane shows (its buffer in VRAM through gpu(4) readback)
rm -f /tmp/wvo.log
window -r 100 100 740 580 /tests/wsysvktri /tmp/wvo.log screen
n=0
while(! grep -s '^wsysvk: exit' /tmp/wvo.log && test $n -lt 600){ sleep 0.1; n=`{echo $n+1 | hoc} }
grep 'wsys says|frames|screen at|passed|FAIL|exit' /tmp/wvo.log | sed 's/^/screen: /'

# fullscreen (wctl fullscreen: no border, all of the screen, above the bars):
# vkcube (it makes its swapchain anew at the new size; vktri's pipeline keeps
# its first size, it ends on out of date) on the overlay plane as the whole
# screen, the client's object; unfullscreen: its window's size again
rm -f /tmp/cube.log
echo '#!/bin/rc
WSI_PLAN9_STATS=1 /tests/vkcube --c 400 >/tmp/cube.log >[2=1]
echo cube: exit $status >>/tmp/cube.log' >/tmp/cube.rc
chmod +x /tmp/cube.rc
window -r 100 100 740 580 /tmp/cube.rc
sleep 2
w=`{ls -p /mnt/wsys | grep '^[0-9]+$' | sort -n | tail -1}
grep '^overlay' /dev/gpu/0/status | sed 's/^/full before: /'
echo fullscreen >/mnt/wsys/$w/wctl
sleep 2
c=`{cat /mnt/wsys/$w/ctl}
echo full: content $c(2-5)
grep '^overlay' /dev/gpu/0/status | sed 's/^/full: /'
echo unfullscreen >/mnt/wsys/$w/wctl
sleep 2
c=`{cat /mnt/wsys/$w/ctl}
echo full after: content $c(2-5)
grep '^overlay' /dev/gpu/0/status | sed 's/^/full after: /'
n=0
while(! grep -s '^cube: exit' /tmp/cube.log && test $n -lt 600){ sleep 0.1; n=`{echo $n+1 | hoc} }
grep 'wsys says|per frame|exit' /tmp/cube.log | sed 's/^/full: /'
