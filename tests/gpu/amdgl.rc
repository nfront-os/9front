#!/bin/rc
# OpenGL ES through zink on RADV (aux/amdgpu): gltest without a window
# (EGL surfaceless), glwin on the screen (EGL's plan9 platform: the
# frames by kopper and the plan9 WSI, scanout with no rio)
bind -a '#i' /dev
bind -a '#v' /dev
aux/amdgpu $* >/tmp/amd.log >[2=1]
sleep 2
MESA_LOADER_DRIVER_OVERRIDE=zink /tests/gltest >[2=1]
echo status $status
WSI_PLAN9_STATS=1 /tests/glwin 300 >[2=1]
echo status $status
grep 'WARN|error|fault' /tmp/amd.log
echo TESTEND
