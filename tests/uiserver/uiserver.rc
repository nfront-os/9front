#!/bin/rc
# run by wsys -x -i (tests/uiserver/run.sh): ui (sys/src/cmd/ui) in a window of
# wsys, a client in rc: mounts its /srv, builds a scene through ctl (one write
# one transaction), reads it back (tree, nodes/), changes a property through
# nodes/id/props, clicks the button (/dev/mousein) and reads the click from
# event, types into the text box (uipeek -k: kbd(3) through /dev/kbdin) and
# reads its text events; a read of event let go (its process killed: Tflush)
# leaves ui answering; the window's pixels from wsys' screen (uipeek); a
# client in C (uiclient: libui) in a window of its own. renderer says what
# draws: the processor here (no GPU), the GPU with uirenderer=gpu.
# Prints ok/FAIL lines and "uiserver: all passed".
nfail=0
fn ok { echo ok $* }
fn fail { echo FAIL $*; nfail=`{echo $nfail+1 | hoc} }
fn check { # what want got
	if(~ $3 $2) ok $1
	if not fail $1: got $"3, want $2
}
fn waitfor { # file pattern
	n=0
	while(! grep -s $2 $1 >[2]/dev/null && test $n -lt 100){ sleep 0.1; n=`{echo $n+1 | hoc} }
}
# mousein keeps the buttons per open file: a press and its release through one
fn m { echo A $1 $2 $3; sleep 0.1 }

window -r 100 100 600 450 '/tests/ui -s uitest >/tmp/ui.log >[2=1]'
n=0
while(! test -e /srv/uitest && test $n -lt 100){ sleep 0.1; n=`{echo $n+1 | hoc} }
if(! test -e /srv/uitest){ fail no /srv/uitest; cat /tmp/ui.log; echo uiserver: failed; exit fail }
mount /srv/uitest /mnt/ui || { fail mount; exit fail }
ok ui posted /srv/uitest, mounted
# what draws the window: cpu without a GPU (VESA), gpu ... with one
# ($uirenderer: what the caller wants, default cpu)
if(~ $#uirenderer 0) uirenderer=cpu
r=`{cat /mnt/ui/renderer}
check 'renderer: '^$"r $uirenderer $r(1)

# the event log, read from the start (each open sees what comes after it)
cat /mnt/ui/event >/tmp/ev &
evpid=$apid
sleep 0.3

# a scene: one write, one transaction
echo 'title uitest
new b button
set b text press me
new t label
set t text hello 9front
new f textbox
set f placeholder type here
new c checkbox
set c text a box
set c checked 0
new p progress
set p value 0.5' >/mnt/ui/ctl && ok scene written
sleep 1
tree=`{cat /mnt/ui/tree | grep -c '^new '}
check 'tree: five nodes' 5 $tree
check 'nodes/t/kind' label `{cat /mnt/ui/nodes/t/kind}
grep -s '^text hello 9front$' /mnt/ui/nodes/t/props && ok 'nodes/t/props' || fail nodes/t/props: `{cat /mnt/ui/nodes/t/props}
# a write with a bad line changes nothing, and says which line
if(echo 'new x label
set nope text a' >/mnt/ui/ctl >[2]/tmp/err) fail a bad transaction taken
if not ok 'a bad transaction refused:' `{cat /tmp/err}
test -e /mnt/ui/nodes/x && fail 'a refused transaction left node x' || ok 'a refused transaction changed nothing'
# a property through the node's props file
echo 'text changed by props' >/mnt/ui/nodes/t/props
grep -s '^set t text changed by props$' /mnt/ui/tree && ok 'props written: in the tree' || fail props write

# the window's pixels: Masonry's background, and widgets drawn on it
sleep 1
bg=`{/tests/uipeek -n 104,104,596,446 1d1d1d}
total=`{echo 492'*'342 | hoc}
other=`{echo $total-$bg | hoc}
if(test $bg -gt 1000 && test $other -gt 500) ok window drawn: $bg background, $other else
if not fail window: $bg of $total background

# where a node is on the screen: the middle of nodes/id/rect, the window's contents at 104,104
# (hoc's int: a dot would end mousein's message); ctl says where the contents are
fn at { # node [mtpt]
	mt=/mnt/ui
	if(! ~ $#2 0) mt=$2
	o=`{cat $mt/ctl}
	r=`{cat $mt/nodes/$1/rect}
	echo `{echo 'int('$o(1)'+('$r(1)+$r(3)')/2)' | hoc} `{echo 'int('$o(2)'+('$r(2)+$r(4)')/2)' | hoc}
}
o=`{cat /mnt/ui/ctl}
check 'ctl: where the contents are' '104 104 492 342' $"o
r=`{cat /mnt/ui/nodes/b/rect}
if(~ $#r 4) ok 'nodes/b/rect:' $r
if not fail no rect for b
# the button: a click; the first click makes the window current (wsys keeps it,
# as rio), the second is the button's
b=`{at b}
{ m $b(1) $b(2) 0; m $b(1) $b(2) 1; m $b(1) $b(2) 0; m $b(1) $b(2) 1; m $b(1) $b(2) 0 } >/dev/mousein
waitfor /tmp/ev '^click b$'
grep -s '^click b$' /tmp/ev && ok 'event: click b' || fail no click event: `{cat /tmp/ev}

# the text box: a click into it (below the button and the label), typed into
f=`{at f}
{ m $f(1) $f(2) 0; m $f(1) $f(2) 1; m $f(1) $f(2) 0 } >/dev/mousein
sleep 0.3
/tests/uipeek -k 'hi'
waitfor /tmp/ev '^text f hi$'
grep -s '^text f hi$' /tmp/ev && ok 'event: text f hi' || fail no text event: `{grep '^text' /tmp/ev}
grep -s '^text hi$' /mnt/ui/nodes/f/props && ok 'the typed text in nodes/f/props' || fail nodes/f/props: `{cat /mnt/ui/nodes/f/props}

# the tree's shape changed (a node made, then deleted): the other widgets stay,
# the text box with its focus and text (before, all were made again)
echo 'new extra label' >/mnt/ui/ctl
sleep 0.3
/tests/uipeek -k '!'
waitfor /tmp/ev '^text f hi!$'
grep -s '^text f hi!$' /tmp/ev && ok 'a node made: the text box keeps its focus and text' || fail after new: `{grep '^text' /tmp/ev}
echo 'del extra' >/mnt/ui/ctl
sleep 0.3
/tests/uipeek -k '?'
waitfor /tmp/ev '^text f hi!\?$'
grep -s '^text f hi!\?$' /tmp/ev && ok 'a node deleted: the text box keeps its focus and text' || fail after del: `{grep '^text' /tmp/ev}

# a read of event let go (its process killed: the kernel's Tflush): ui answers on
echo kill >/proc/$evpid/note
sleep 0.3
echo 'set p value 1' >/mnt/ui/ctl && grep -s '^set p value 1$' /mnt/ui/tree && ok 'ui answers after a flushed read' || fail ui after a flushed read

# a long list: a thousand labels, widgets only for those it shows (their rect)
echo clear >/mnt/ui/ctl
echo 'new l list
set l flex 1' >/mnt/ui/ctl
for(i in `{seq 0 999})
	echo 'new l'$i' label l
set l'$i' text item '$i >/mnt/ui/ctl
sleep 1
check 'list: a thousand children' 1000 `{cat /mnt/ui/nodes/l/children | wc -l}
fn hasrect { ! ~ `{cat /mnt/ui/nodes/$1/rect} '' } # (stat gives the files no length)
fn shown { # how many of the list's children have a widget (a rect)
	n=0
	for(i in `{seq 0 999})
		if(hasrect l$i) n=`{echo $n+1 | hoc}
	echo $n
}
s=`{shown}
if(hasrect l0 && ! hasrect l999 && test $s -gt 5 && test $s -lt 100)
	ok 'list: widgets only for those seen:' $s of 1000
if not fail list: $s widgets, l0 `{cat /mnt/ui/nodes/l0/rect}, l999 `{cat /mnt/ui/nodes/l999/rect}
# scrolled on (the wheel over it): the first ones' widgets go, later ones' come
{ for(i in `{seq 1 60}){ echo A 350 300 16; echo A 350 300 0 } } >/dev/mousein
sleep 1
s=`{shown}
if(! hasrect l0 && test $s -gt 5 && test $s -lt 100)
	ok 'list: scrolled, the first ones without widgets, others with:' $s
if not fail list scrolled: $s widgets, l0 `{cat /mnt/ui/nodes/l0/rect}
# a node made in the list's middle and one deleted: the list stays as long
echo 'new lx label l 5
set lx text inserted
del l7' >/mnt/ui/ctl
sleep 0.5
check 'list: one made, one deleted' 1000 `{cat /mnt/ui/nodes/l/children | wc -l}

# more kinds: an image (its picture written to nodes/id/image: image(6), crop's
# compressed form,
# wsys' screen), a menu, a switch, a divider, a spinner, a grid of 3 columns
echo clear >/mnt/ui/ctl
echo 'new img image
new sel select
set sel options red|green|blue
set sel selected 1
new sw switch
new dv divider
new sp spinner
new g grid
set g columns 3' >/mnt/ui/ctl
for(i in 0 1 2 3 4 5)
	echo 'new g'$i' label g
set g'$i' text cell '$i >/mnt/ui/ctl
crop -r 0 0 40 30 /mnt/wsys/screen >/mnt/ui/nodes/img/image || fail image written: $status
sleep 1
wh=`{cat /mnt/ui/nodes/img/image}
check 'image: its picture, 40 by 30' '40 30' $"wh
# the same as PNG (topng), into another
echo 'new img2 image' >/mnt/ui/ctl
crop -r 0 0 24 16 /mnt/wsys/screen | topng >/mnt/ui/nodes/img2/image || fail png written: $status
wh=`{cat /mnt/ui/nodes/img2/image}
check 'image: a PNG, 24 by 16' '24 16' $"wh
for(n in img sel sw dv sp g)
	if(! hasrect $n) fail $n: no widget
ok 'image, select, switch, divider, spinner, grid: widgets'
r0=`{cat /mnt/ui/nodes/g0/rect}
r3=`{cat /mnt/ui/nodes/g3/rect}
r1=`{cat /mnt/ui/nodes/g1/rect}
if(~ $r3(1) $r0(1) && test $r3(2) -gt $r0(2) && test $r1(1) -gt $r0(1))
	ok 'grid: cell 3 below cell 0, cell 1 right of it'
if not fail grid: g0 $r0, g1 $r1, g3 $r3
check 'select: the scene has its option' 1 `{grep '^selected ' /mnt/ui/nodes/sel/props | awk '{print $2}'}
# the switch clicked: check sw 1
o=`{cat /mnt/ui/ctl}
w=`{cat /mnt/ui/nodes/sw/rect}
x=`{echo $o(1)+'('$w(1)+$w(3)')'/2 | hoc}
y=`{echo $o(2)+'('$w(2)+$w(4)')'/2 | hoc}
cat /mnt/ui/event >/tmp/ev3 &
evpid3=$apid
sleep 0.3
{ m $x $y 0; m $x $y 1; m $x $y 0 } >/dev/mousein
waitfor /tmp/ev3 '^check sw 1$'
grep -s '^check sw 1$' /tmp/ev3 && ok 'switch: clicked, check sw 1' || fail switch: `{cat /tmp/ev3}
echo kill >/proc/$evpid3/note

# a node's look: a label's background red, then blue in place (its widget stays)
echo clear >/mnt/ui/ctl
echo 'new st label
set st text styled
set st padding 10
set st background #ff0000
set st radius 0' >/mnt/ui/ctl
sleep 1
fn inside { # node colour: how many of its pixels on the screen are it
	box=`{echo `{cat /mnt/ui/ctl} `{cat /mnt/ui/nodes/$1/rect} | awk '{printf "%d,%d,%d,%d\n", $1+$5, $2+$6, $1+$7, $2+$8}'}
	/tests/uipeek -n $box $2
}
red=`{inside st ff0000}
if(test $red -gt 200) ok 'look: background red,' $red pixels
if not fail look: red $red, rect `{cat /mnt/ui/nodes/st/rect}
echo 'set st background #0000ff' >/mnt/ui/ctl
sleep 1
blue=`{inside st 0000ff}
red=`{inside st ff0000}
if(test $blue -gt 200 && ~ $red 0) ok 'look: changed in place to blue,' $blue pixels
if not fail look: blue $blue red $red

# the window deleted: wsys ends ui with a note (as rio); its /srv/uitest goes
# with it (ORCLOSE), a read of event ends
cat /mnt/ui/event >/tmp/ev2 &
sleep 0.2
# ui's window: the only one (wsys' /mnt/wsys/1)
echo delete >/mnt/wsys/1/wctl
n=0
while(test -e /srv/uitest && test $n -lt 50){ sleep 0.1; n=`{echo $n+1 | hoc} }
test -e /srv/uitest && fail '/srv/uitest left after the window went' || ok '/srv/uitest gone with the window'
sleep 0.3
ps | grep -s ' ui$' && fail 'ui still running' || ok 'ui gone, the reader of event let go'

unmount /mnt/ui >[2]/dev/null

# a client in C (uiclient.c, libui: ui(2)): ui in a new window (uinew: /bin/ui
# in wsys' namespace, the test's ui bound there by run.sh), a
# scene; two clicks of its button counted in its label
/tests/uiclient >/tmp/uic >[2=1] </dev/null &
uicpid=$apid
waitfor /tmp/uic '^ready'
if(! grep -s '^ready' /tmp/uic) fail uiclient: `{cat /tmp/uic}
if not {
	ok uiclient: `{grep '^ready' /tmp/uic}
	grep -s '^text  check me $' /mnt/uic/nodes/c/props && ok 'uiset: blanks kept' || fail uiset: `{cat /mnt/uic/nodes/c/props}
	grep -s '^title uiclient$' /mnt/uic/tree && ok 'uinew: the title' || fail uinew title: `{grep '^title' /mnt/uic/tree}
	sleep 1
	b=`{at b /mnt/uic}
	# a click until the button has one: the first may only make the window current
	n=0
	while(! grep -s '^event click b' /tmp/uic && test $n -lt 3){
		{ m $b(1) $b(2) 0; m $b(1) $b(2) 1; m $b(1) $b(2) 0 } >/dev/mousein
		sleep 0.5
		n=`{echo $n+1 | hoc}
	}
	grep -s '^text count 1$' /mnt/uic/nodes/l/props && ok 'uiclient: the label says count 1' || fail uiclient label: `{cat /mnt/uic/nodes/l/props}
	{ m $b(1) $b(2) 1; m $b(1) $b(2) 0 } >/dev/mousein
	waitfor /tmp/uic '^count'
	c=`{grep '^count' /tmp/uic}
	check 'uiclient: two clicks counted' 'count 2' $"c
}
test -e /proc/$uicpid && echo kill >/proc/$uicpid/note

# a program in Rust (uitodo: uiview, views of its state as Xilem's): its
# window's files mounted here as well (it mounts them in a namespace of its
# own); an item added (the button, then enter), checked, taken away; the
# list in its file after each
fn tnode { grep '^new [^ ]* '$1 /mnt/uit/tree | sed -n $2^p | awk '{print $2}' }
fn click { p=`{at $1 /mnt/uit}; { m $p(1) $p(2) 0; m $p(1) $p(2) 1; m $p(1) $p(2) 0 } >/dev/mousein; sleep 0.5 }
fn waitfile { # file pattern
	n=0
	while(! grep -s $2 $1 >[2]/dev/null && test $n -lt 50){ sleep 0.1; n=`{echo $n+1 | hoc} }
	grep -s $2 $1 >[2]/dev/null
}
rm -f /tmp/todo
/tests/uitodo -f /tmp/todo >/tmp/uitodo.log >[2=1] </dev/null &
todopid=$apid
s=/srv/ui.glenda.$todopid.0
n=0
while(! test -e $s && test $n -lt 100){ sleep 0.1; n=`{echo $n+1 | hoc} }
if(! test -e $s || ! mount $s /mnt/uit) fail uitodo: no $s: `{cat /tmp/uitodo.log}
if not {
	cat /mnt/uit/event >/tmp/uitev &
	uitevpid=$apid
	waitfor /mnt/uit/tree textbox
	f=`{tnode textbox 1}
	add=`{tnode button 1}
	if(~ $#f 1 && ~ $#add 1) ok uitodo: its scene, text box $f, button $add
	if not fail uitodo scene: `{cat /mnt/uit/tree}
	# the first click may only make the window current
	click $f; click $f
	/tests/uipeek -k milk
	sleep 0.3
	click $add
	waitfile /tmp/todo '^0 milk$' && ok 'uitodo: milk added (the button)' || fail uitodo add: `{cat /tmp/todo}
	grep -s 'text 1 of 1 to do$' /mnt/uit/tree && ok 'uitodo: 1 of 1 to do' || fail uitodo label: `{grep 'to do' /mnt/uit/tree}
	if(grep -s '^set '$f' text .' /mnt/uit/tree && ! grep -s '^set '$f' text ''''$' /mnt/uit/tree) fail uitodo text box not empty: `{grep '^set '$f' text' /mnt/uit/tree}
	if not ok 'uitodo: the text box emptied'
	click $f
	/tests/uipeek -k 'eggs
'
	waitfile /tmp/todo '^0 eggs$' && ok 'uitodo: eggs added (enter)' || fail uitodo enter: `{cat /tmp/todo}
	c=`{tnode checkbox 1}
	click $c
	waitfile /tmp/todo '^1 milk$' && ok 'uitodo: milk done' || fail uitodo check: `{cat /tmp/todo}
	grep -s 'text 1 of 2 to do$' /mnt/uit/tree && ok 'uitodo: 1 of 2 to do' || fail uitodo label: `{grep 'to do' /mnt/uit/tree}
	away=`{tnode button 2}
	click $away
	n=0
	while(grep -s milk /tmp/todo && test $n -lt 50){ sleep 0.1; n=`{echo $n+1 | hoc} }
	l=`{cat /tmp/todo}
	check 'uitodo: milk away, eggs left' '0 eggs' $"l
	echo kill >/proc/$uitevpid/note
	unmount /mnt/uit
}
# uitick (uiview's Proxy::every): a count a timer advances, no input; the
# button stops it
/tests/uitick >/tmp/uitick.log >[2=1] </dev/null &
tickpid=$apid
s=/srv/ui.glenda.$tickpid.0
n=0
while(! test -e $s && test $n -lt 100){ sleep 0.1; n=`{echo $n+1 | hoc} }
if(! test -e $s || ! mount $s /mnt/uit) fail uitick: no $s: `{cat /tmp/uitick.log}
if not {
	fn tick { grep '^set [^ ]* text tick ' /mnt/uit/tree | awk '{print $5}' }
	waitfor /mnt/uit/tree 'text tick'
	a=`{tick}
	sleep 1
	b=`{tick}
	if(test $b -gt $a) ok 'uitick: the timer counts without input:' $a then $b
	if not fail uitick: $a then $b
	stop=`{tnode button 1}
	# the first click may only make the window current
	click $stop
	sleep 0.5
	if(! grep -s 'text start$' /mnt/uit/tree){ click $stop; sleep 0.5 }
	if(grep -s 'text start$' /mnt/uit/tree){
		a=`{tick}
		sleep 1
		b=`{tick}
		check 'uitick: stopped' $a $b
	}
	if not fail uitick: not stopped: `{grep text /mnt/uit/tree}
	unmount /mnt/uit
}
test -e /proc/$tickpid && echo kill >/proc/$tickpid/note

test -e /proc/$todopid && echo kill >/proc/$todopid/note

# a client in Go (gocount: sys/src/libui/go, the /srv file mounted on
# /mnt/srvname): two clicks counted (run.sh builds it with
# ../9front-go when it is there)
if(test -x /tests/gocount){
	/tests/gocount -n 2 >/tmp/goc >[2=1] </dev/null &
	gocpid=$apid
	waitfor /tmp/goc '^ready'
	s=`{grep '^ready' /tmp/goc | awk '{print $2}'}
	if(~ $#s 0 || ! mount /srv/$s /mnt/uig) fail gocount: `{cat /tmp/goc}
	if not {
		ok gocount: ready $s
		sleep 1
		b=`{at b /mnt/uig}
		n=0
		while(! grep -s '^event click b' /tmp/goc && test $n -lt 3){
			{ m $b(1) $b(2) 0; m $b(1) $b(2) 1; m $b(1) $b(2) 0 } >/dev/mousein
			sleep 0.5
			n=`{echo $n+1 | hoc}
		}
		{ m $b(1) $b(2) 1; m $b(1) $b(2) 0 } >/dev/mousein
		waitfor /tmp/goc '^count'
		c=`{grep '^count' /tmp/goc}
		check 'gocount: two clicks counted' 'count 2' $"c
		grep -s '^text count 2$' /tmp/goc && ok 'gocount: its label read back (nodes/l/props)' || fail gocount props: `{cat /tmp/goc}
		unmount /mnt/uig
		# over the network: the window's files exported (exportfs on tcp),
		# a gocount there with 9P of its own (-d), one click
		mount /srv/$s /mnt/uin
		aux/listen1 -t tcp!*!5640 /bin/exportfs -r /mnt/uin >[2]/dev/null &
		lpid=$apid
		sleep 0.5
		# the guest's own address (no loopback interface in it)
		ip=`{grep -v : /net/ipifc/0/local | awk '{print $1}' | sed 1q}
		/tests/gocount -n 1 -d tcp!$ip!5640 >/tmp/gon >[2=1] </dev/null &
		gonpid=$apid
		waitfor /tmp/gon '^ready'
		if(! grep -s '^ready' /tmp/gon) fail gocount -d: `{cat /tmp/gon}
		if not {
			ok gocount -d: `{grep '^ready' /tmp/gon}
			sleep 0.5
			b=`{at b /mnt/uin}
			n=0
			while(! grep -s '^event click b' /tmp/gon && test $n -lt 3){
				{ m $b(1) $b(2) 0; m $b(1) $b(2) 1; m $b(1) $b(2) 0 } >/dev/mousein
				sleep 0.5
				n=`{echo $n+1 | hoc}
			}
			waitfor /tmp/gon '^count'
			c=`{grep '^count' /tmp/gon}
			check 'gocount over tcp: one click' 'count 1' $"c
		}
		test -e /proc/$gonpid && echo kill >/proc/$gonpid/note
		echo kill >/proc/$lpid/note
		unmount /mnt/uin
	}
	test -e /proc/$gocpid && echo kill >/proc/$gocpid/note
}
if not echo skip gocount: no Go '(../9front-go)'

cat /tmp/ui.log | grep -v '^uitest$'
if(~ $nfail 0) echo uiserver: all passed
if not echo uiserver: $nfail failed
