#!/bin/rc
# run by tests/wayland/run.sh (VESA guest): weston's simple-shm under wlsys
# outlives its wsys, twice. wlsys started in a window of wsys A, as one
# does; A exits (its -i command done: the windows' processes hung up);
# wsys B: wlsys mounts it (/srv/wsys.$user) and makes the window again,
# which draws and moves. B killed (every proc: a crash); wsys C: the window
# again; deleted there, the client goes.
rfork ne
bind -a '#i' /dev
bind -a '#m' /dev
fn waitsrv { # pid of the wsys whose srv entry to wait for
	n=0
	while(! test -e /srv/wsys.$user.$1 && test $n -lt 100){ sleep 0.1; n=`{echo $n+1 | hoc} }
}
fn wsysmount { # name of the wsys
	if(mount /srv/wsys.$user /mnt/wsys) echo ok /srv/wsys.$user mounted: wsys $1
	if not echo FAIL /srv/wsys.$user mounted: wsys $1
}
fn alive { # what
	w=`{cat /tmp/wlsys.pid}
	if(test -e /proc/$w) echo ok wlsys outlives $1
	if not echo FAIL wlsys gone with $1
}
rm -f /tmp/wlsys.pid
# A: wlsys in its window; A exits when the window's rc is done
/tests/wsys -x -i /tests/restartA.rc >/tmp/wsysA.log >[2=1]
grep '^(ok|FAIL|wlwatch) ' /tmp/wsysA.log
sleep 1
unmount /mnt/wsys >[2]/dev/null
alive 'wsys A (exited)'
# B: the window again; then B killed
/tests/wsys >/tmp/wsysB.log >[2=1] &
b=$apid
waitsrv $b
wsysmount B
/tests/wlwatch -k simple-shm
# all of B's procs, nothing else (its note group: a desktop's wsys stays)
echo killing wsys B
echo kill >/proc/$b/notepg
sleep 1
unmount /mnt/wsys >[2]/dev/null
alive 'wsys B (killed)'
# C: the window again, deleted
/tests/wsys >/tmp/wsysC.log >[2=1] &
c=$apid
waitsrv $c
wsysmount C
/tests/wlwatch simple-shm
w=`{cat /tmp/wlsys.pid}
n=0
while(test -e /proc/$w && test $n -lt 50){ sleep 0.1; n=`{echo $n+1 | hoc} }
if(test -e /proc/$w){
	echo FAIL simple-shm still running after the delete
	ps | grep -v ' (listen|Wakeme|Idle) '
	sed 's/^/log: /' /tmp/restart.log
	echo kill >/proc/$w/ctl
}
if not echo ok simple-shm gone after the delete in wsys C
echo kill >/proc/$c/notepg
# (Plan 9's grep: | without a backslash)
grep 'wlsys: (wsys|/srv)' /tmp/restart.log
