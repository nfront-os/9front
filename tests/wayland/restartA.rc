#!/bin/rc
# wsysrestart.rc's first part, the -i command of wsys A: wlsys started in
# this window, simple-shm's window watched (kept); then this rc ends and
# with it wsys A (-x)
/tests/wlsys -d /tests/weston-simple-shm >/tmp/restart.log >[2=1] &
echo $apid >/tmp/wlsys.pid
/tests/wlwatch -k simple-shm
