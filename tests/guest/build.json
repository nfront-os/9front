[
	{
		"Name": "guest-tests",
		"Include": [
			"/$ARCH/cflags.json"
		],
		"Install": "/tests/guest/root/tests/",
		"Oflags": [
			"--entry=_main"
		],
		"Libs": [
			"--start-group",
			"/$ARCH/lib.gcc/libdisk.a",
			"/$ARCH/lib.gcc/lib9p.a",
			"/$ARCH/lib.gcc/libthread.a",
			"/$ARCH/lib.gcc/libauth.a",
			"/$ARCH/lib.gcc/libauthsrv.a",
			"/$ARCH/lib.gcc/libndb.a",
			"/$ARCH/lib.gcc/libip.a",
			"/$ARCH/lib.gcc/libsec.a",
			"/$ARCH/lib.gcc/libmp.a",
			"/$ARCH/lib.gcc/libflate.a",
			"/$ARCH/lib.gcc/libregexp.a",
			"/$ARCH/lib.gcc/libString.a",
			"/$ARCH/lib.gcc/libbio.a",
			"/$ARCH/lib.gcc/libc.a",
			"--end-group"
		],
		"SourceFilesCmd": [
			"libctest.c",
			"threadtest.c",
			"authtest.c",
			"mptest.c",
			"paktest.c",
			"segtest.c",
			"segpager.c",
			"segshared.c"
		]
	},
	{
		"Name": "guest-apetests",
		"Include": [
			"/$ARCH/cflags.json",
			"/$ARCH/ape.json"
		],
		"Ape": true,
		"Cflags": [
			"-D_POSIX_SOURCE"
		],
		"Install": "/tests/guest/root/tests/",
		"Oflags": [
			"--entry=_main"
		],
		"Libs": [
			"--start-group",
			"/$ARCH/lib.gcc/ape/libdraw.a",
			"/$ARCH/lib.gcc/ape/libplumb.a",
			"/$ARCH/lib.gcc/ape/libauth.a",
			"/$ARCH/lib.gcc/ape/libsec.a",
			"/$ARCH/lib.gcc/ape/libmp.a",
			"/$ARCH/lib.gcc/ape/libbsd.a",
			"/$ARCH/lib.gcc/ape/libnet.a",
			"/$ARCH/lib.gcc/ape/libl.a",
			"/$ARCH/lib.gcc/ape/libv.a",
			"/$ARCH/lib.gcc/ape/libz.a",
			"/$ARCH/lib.gcc/ape/libbz2.a",
			"/$ARCH/lib.gcc/ape/libbio.a",
			"/$ARCH/lib.gcc/ape/lib9.a",
			"/$ARCH/lib.gcc/ape/libfmt.a",
			"/$ARCH/lib.gcc/ape/libutf.a",
			"/$ARCH/lib.gcc/ape/libap.a",
			"--end-group"
		],
		"SourceFilesCmd": [
			"apetest.c"
		]
	},
	{
		"Name": "guest-apegnutests",
		"Include": [
			"/$ARCH/cflags.json",
			"/$ARCH/ape.json"
		],
		"Ape": true,
		"Cflags": [
			"-D_POSIX_SOURCE=",
			"-D_LIMITS_EXTENSION=",
			"-D_APE_GNU"
		],
		"Install": "/tests/guest/root/tests/",
		"Oflags": [
			"--entry=_main"
		],
		"Libs": [
			"--start-group",
			"/$ARCH/lib.gcc/ape/libdraw.a",
			"/$ARCH/lib.gcc/ape/libplumb.a",
			"/$ARCH/lib.gcc/ape/libauth.a",
			"/$ARCH/lib.gcc/ape/libsec.a",
			"/$ARCH/lib.gcc/ape/libmp.a",
			"/$ARCH/lib.gcc/ape/libbsd.a",
			"/$ARCH/lib.gcc/ape/libnet.a",
			"/$ARCH/lib.gcc/ape/libl.a",
			"/$ARCH/lib.gcc/ape/libv.a",
			"/$ARCH/lib.gcc/ape/libz.a",
			"/$ARCH/lib.gcc/ape/libbz2.a",
			"/$ARCH/lib.gcc/ape/libbio.a",
			"/$ARCH/lib.gcc/ape/lib9.a",
			"/$ARCH/lib.gcc/ape/libfmt.a",
			"/$ARCH/lib.gcc/ape/libutf.a",
			"/$ARCH/lib.gcc/ape/libap.a",
			"--end-group"
		],
		"SourceFilesCmd": [
			"apegnutest.c"
		]
	}
]
