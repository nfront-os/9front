#!/bin/rc
# the desktop's parts of wsys, run by wsys -x -i: a window's wsys/ (rio's
# /dev/wsys: all the windows, for winwatch), winwatch running on it; Mod4+Tab
# makes the bottom window current and top (through all in turn), Shift back;
# a Tab without Mod4 is the window's. Prints ok/FAIL lines and "desk: all passed".
fn fail { echo FAIL $*; exit fail }
fn wait1 { # cmd...: until it succeeds, 10 s at most
	n=0
	while(! $* >[2]/dev/null && test $n -lt 100){ sleep 0.1; n=`{echo $n+1 | hoc} }
	$* >[2]/dev/null
}
fn current { # the current window's number
	for(d in `{ls -p /mnt/wsys | grep '^[0-9]+$'}){
		w=`{dd -if /mnt/wsys/$d/wctl -bs 128 -count 1 -quiet 1}
		if(~ $w(5) current) echo $d
	}
}
fn top { # the top window (stack: bottom to top)
	tail -1 /mnt/wsys/stack | awk '{print $1}'
}
fn mod4tab { # [shift]
	/tests/uipeek -p f868
	if(~ $1 shift) /tests/uipeek -p f016
	/tests/uipeek -p 9
	/tests/uipeek -r 9
	if(~ $1 shift) /tests/uipeek -r f016
	/tests/uipeek -r f868
	sleep 0.3
}
echo A 1020 760 0 >/dev/mousein

window -r 50 50 300 200
window -r 350 50 600 200
window -r 650 50 900 200
wait1 test -d /mnt/wsys/3 || fail three windows
sleep 1
for(i in 1 2 3) echo -n w$i >/mnt/wsys/$i/label

# wsys/ in a window: all of them, their files
l=`{ls -p /mnt/wsys/1/wsys}
~ $"l '1 2 3' || fail wsys/: $l
~ `{cat /mnt/wsys/1/wsys/3/label} w3 || fail wsys/3/label: `{cat /mnt/wsys/1/wsys/3/label}
echo ok a window sees all windows in its wsys/: $l
window -r 50 300 600 400 winwatch
sleep 2
ps | grep -s ' winwatch$' || fail winwatch did not run
echo ok winwatch runs on it

# Mod4+Tab: windows 1 2 3 4 (winwatch's on top, current); the bottom one comes up
c0=`{current}
mod4tab
c1=`{current}
~ $c1 1 || fail Mod4+Tab: current $c1, want 1 (was $c0)
~ `{top} 1 || fail Mod4+Tab: top `{top}, want 1
mod4tab
~ `{current} 2 || fail Mod4+Tab again: current `{current}, want 2
echo ok Mod4+Tab: 1 then 2 current and top
mod4tab shift
~ `{current} 1 || fail Mod4+Shift+Tab: current `{current}, want 1
echo ok Mod4+Shift+Tab: back to 1

# a Tab without Mod4: the window's (text window 1: a tab in its line)
/tests/uipeek -k 'echo a	b'
/tests/uipeek -k '
'
sleep 0.5
grep -s 'a	b' /mnt/wsys/1/text || fail a Tab without Mod4 did not reach the window: `{tail -2 /mnt/wsys/1/text}
echo ok a Tab without Mod4 goes to the window
echo desk: all passed
