[
	{
		"Name": "buildflags",
		"Cflags": [
			"-std=gnu17",
			"-fno-asm",
			"-ffreestanding",
			"-nostdinc",
			"-Ulinux",
			"-U__linux",
			"-U__linux__",
			"-U__gnu_linux__",
			"-D__plan9__",
			"-fno-builtin",
			"-fno-omit-frame-pointer",
			"-fno-stack-protector",
			"-fplan9-extensions",
			"-fcommon",
			"-Wno-error=implicit-int",
			"-Wno-error=incompatible-pointer-types",
			"-Wno-error=int-conversion",
			"-Wno-error=comment",
			"-g",
			"-gdwarf-2",
			"-ggdb",
			"-mcmodel=small",
			"-O2",
			"-fno-strict-aliasing",
			"-fwrapv",
			"-fno-delete-null-pointer-checks",
			"-static"
		],
		"Oflags": [
			"-z",
			"noseparate-code",
			"-z",
			"max-page-size=0x1000",
			"-T",
			"/$ARCH/plan9.ld"
		],
		"Include": [
			"/$ARCH/$CC.json"
		]
	}
]
