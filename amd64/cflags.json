[
	{
		"Name": "buildflags",
		"Cflags": [
			"-ffreestanding",
			"-fno-builtin",
			"-fno-omit-frame-pointer",
			"-fno-stack-protector",
			"-fplan9-extensions",
			"-fcommon",
			"-g",
			"-gdwarf-2",
			"-ggdb",
			"-mcmodel=small",
			"-O0",
			"-static"
		],
		"Oflags": [
			"-z",
			"noseparate-code",
			"-z",
			"max-page-size=0x200000"
		],
		"Include": [
			"/$ARCH/$CC.json"
		]
	}
]
