#!/bin/rc
# i915run: Linux 6.6's i915 on the LinuxKPI (aux/i915), its output into
# a log on the ESP (FAT) of the USB stick the system booted from, as
# i915.log (written through: it survives a hang), as intelrun does.
#	i915run [-a] [aux/i915 flags]
# without -a the display stays 9front's (i915.disable_display); with
# -a i915 takes the outputs too (the screen may go dark: read the log).
# The driver gets until it has started (at most 60 seconds) and 5 more,
# then its procs, their call chains and state go in the log; a trap in
# the driver puts its chain there too.
rfork e
if(ps | grep -s ' i915$'){
	echo i915run: aux/i915 runs already: reboot for another run
	exit running
}
log=/tmp/i915.log
for(d in '#σ/usb'/sdU*/esp)
	if(~ $log /tmp/i915.log && test -r $d){
		dossrv -f $d i915run.esp >/dev/null >[2=1]
		if(mount -c /srv/i915run.esp /n/esp){
			log=/n/esp/i915.log
			echo i915run: log on $d as i915.log
		}
		rm -f /srv/i915run.esp
	}
if(~ $log /tmp/i915.log)
	echo i915run: no USB stick with an ESP: the log is $log
flags=(-D -v -d 0x1ff)
if(~ $1 -a){
	flags=(-v -d 0x1ff)
	shift
}
{echo '# i915run' `{date}; cat /dev/osversion; echo} >$log
echo '## #G/0/ctl' >>$log
cat '#G/0/ctl' >>$log
echo '## aux/i915 -T (the KPI on this machine)' >>$log
aux/i915 -T >>$log >[2=1]
echo '## aux/i915' $flags $* >>$log
aux/i915 $flags $* >>$log >[2=1] &
# until it has started (or is gone), at most 60 s; then 5 s more
for(i in `{seq 60}){
	if(grep -s '^i915: started' $log || ! ps | grep -s ' i915$')
		i=done
	if(! ~ $i done)
		sleep 1
}
sleep 5
# the driver through gpu(4): contexts, objects, batches, fences
if(test -e /dev/gpu/0/clone){
	echo '## /dev/gpu/0/status' >>$log
	cat /dev/gpu/0/status >>$log >[2=1]
	echo '## aux/inteltest' >>$log
	aux/inteltest >>$log >[2=1]
	echo '## status' $status >>$log
}
echo '## then: procs' >>$log
ps | grep i915 >>$log
# still there: each proc's state and call chain (addresses: addr2line
# -e amd64/bin/aux/i915 on the build machine)
for(p in `{ps | awk '$7 == "i915" {print $2}'}){
	echo '## proc' $p `{cat /proc/$p/status} >>$log
	aux/i915stk $p >>$log >[2=1]
}
echo '## #G/0/ctl' >>$log
cat '#G/0/ctl' >>$log
echo '## end' >>$log
cat $log | tail -40
