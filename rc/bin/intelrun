#!/bin/rc
# intelrun: the Intel GPU driver, its test and Vulkan (vulkaninfo,
# vktri, vkcube: hasvk), their output into a log
# on the ESP (FAT) of the USB stick the system booted from, as gpu.log:
# to be read on another machine instead of photographed.  The log is
# written there as it grows (dossrv writes every write through), so
# that it survives a hang of the machine.
#	intelrun [driver flags]
rfork e
log=/tmp/gpu.log
for(d in '#σ/usb'/sdU*/esp)
	if(~ $log /tmp/gpu.log && test -r $d){
		dossrv -f $d intelrun.esp >/dev/null >[2=1]
		if(mount -c /srv/intelrun.esp /n/esp){
			log=/n/esp/gpu.log
			echo intelrun: log on $d as gpu.log
		}
		rm -f /srv/intelrun.esp
	}
if(~ $log /tmp/gpu.log)
	echo intelrun: no USB stick with an ESP: the log is $log
{echo '# intelrun' `{date}; cat /dev/osversion; echo} >$log
echo '## aux/intelgpu' $* >>$log
aux/intelgpu $* >>$log >[2=1]
echo '## aux/inteltest' >>$log
aux/inteltest >>$log >[2=1]
# Vulkan through hasvk (libdrm over gpu(4)); in a rio window
if(test -d /$objtype/vk)
	bind -a /$objtype/vk /bin
for(c in 'vulkaninfo --summary' 'vktri 3' 'vkcube --c 300'){
	echo '##' $c >>$log
	eval $c >>$log >[2=1]
	echo '## status' $status >>$log
}
echo '## #G/0/ctl' >>$log
cat '#G/0/ctl' >>$log
echo '## /dev/gpu/0/status' >>$log
cat /dev/gpu/0/status >>$log
echo '## end' >>$log
cat $log
