#!/bin/rc
# esplog file: the lines of standard input appended to file one by one,
# each with a write of its own that closes the file again: dossrv writes
# a FAT's changes when a file is closed, so a log on the boot stick's ESP
# (gpustart, wsys -g) keeps what was written before a power off.  Ends at
# the end of its input.
rfork e
if(! ~ $#* 1){
	echo usage: esplog file >[1=2]
	exit usage
}
while(l=`''{read}){
	echo -n $l >>$1
}
