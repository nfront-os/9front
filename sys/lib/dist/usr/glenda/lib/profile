bind -a $home/bin/rc /bin
bind -a $home/bin/$cputype /bin
if(! syscall create /tmp/xxx 1 0666 >[2]/dev/null)
	ramfs	# in case we're running off a cd
font=/lib/font/bit/vga/unicode.font
switch($service){
case terminal
	if(! webcookies >[2]/dev/null)
		webcookies -f /tmp/webcookies
	webfs
	plumber
	echo -n accelerated > '#m/mousectl'
	echo -n 'res 3' > '#m/mousectl'
	prompt=('term% ' '	')
	fn term%{ $* }
	# nfront: desktop=wsys (plan9.ini; the default where wsys is installed)
	# starts wsys(4), the window system of the ui framework, instead of
	# rio (desktop=rio), with the options in
	# wsysflags (-p: the processor composes, not the GPU); riostart serves both
	# (with wsysflags, what wsys says goes to wsysboot.log on the boot
	# stick's ESP, if gpustart served it: a line at a time, esplog)
	# (a chain of if not: each refers to the if just before it)
	# the default: wsys where it is installed (the profiles ui and full)
	if(~ $#desktop 0 && test -x /bin/wsys)
		desktop=wsys
	if(~ $desktop wsys && test -x /bin/wsys && ! ~ $#wsysflags 0 && test -e /srv/gpu.esp && mount -c /srv/gpu.esp /n/esp >[2]/dev/null){
		echo '# wsys' $wsysflags `{date} >>/n/esp/wsysboot.log
		wsys $wsysflags -i riostart >[2=1] | esplog /n/esp/wsysboot.log
	}
	if not if(~ $desktop wsys && test -x /bin/wsys)
		wsys $wsysflags -i riostart
	if not
		rio -i riostart
case cpu
	bind /mnt/term/dev/cons /dev/cons
	bind -q /mnt/term/dev/consctl /dev/consctl
	>[2] /dev/null {
		cp /dev/sysname /mnt/term/dev/label
		if(test -s /mnt/term/env/wsys)
			wsys=/mnt/term^`{cat /mnt/term/env/wsys}
	} 
	bind -a /mnt/term/dev /dev
	prompt=('cpu% ' '	')
	fn cpu%{ $* }
case con
	prompt=('cpu% ' '	')
}
