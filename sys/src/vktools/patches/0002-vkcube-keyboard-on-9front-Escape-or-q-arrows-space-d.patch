Subject: [PATCH] vkcube: keyboard on 9front (Escape or q, arrows, space;
 /dev/cons raw)

---
 cube/cube.c | 43 ++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 42 insertions(+), 1 deletion(-)

diff --git a/cube/cube.c b/cube/cube.c
index 9109cb3..42c5bb4 100644
--- a/cube/cube.c
+++ b/cube/cube.c
@@ -3246,9 +3246,50 @@ static void demo_run(struct demo *demo) {
 }
 #endif
 #if defined(VK_USE_PLATFORM_PLAN9_9FRONT)
-// 9front: the surface is the process's window (rio) or the screen; no input
+#include <fcntl.h>
+#include <pthread.h>
+#include <unistd.h>
+
+// 9front: the keyboard is /dev/cons in raw mode, read on a thread of its own:
+// Escape or q quits, the arrows turn the cube, space pauses
+static void *demo_plan9_keys(void *arg) {
+    struct demo *demo = arg;
+    unsigned char b[64];
+    int ctl, cons;
+
+    if ((ctl = open("/dev/consctl", O_WRONLY)) < 0 || write(ctl, "rawon", 5) != 5) return NULL;
+    if ((cons = open("/dev/cons", O_RDONLY)) < 0) return NULL;
+    for (;;) {
+        ssize_t n = read(cons, b, sizeof b);
+        if (n <= 0) break;
+        for (ssize_t i = 0; i < n; i++) {
+            if (b[i] == 0x1b || b[i] == 'q') {
+                demo->quit = true;
+            } else if (b[i] == ' ') {
+                demo->pause = !demo->pause;
+            } else if (b[i] == 0xef && i + 2 < n && b[i + 1] == 0x80) {
+                // Kleft U+F011, Kright U+F012 (keyboard.h), in UTF-8
+                if (b[i + 2] == 0x91) demo->spin_angle -= demo->spin_increment;
+                if (b[i + 2] == 0x92) demo->spin_angle += demo->spin_increment;
+                i += 2;
+            }
+        }
+    }
+    close(cons);
+    close(ctl);
+    return NULL;
+}
+
+// the surface is the process's window (rio) or the screen
 static void demo_run_plan9(struct demo *demo) {
+    pthread_t keys;
+
+    pthread_create(&keys, NULL, demo_plan9_keys, demo);
     while (!demo->quit) {
+        if (demo->pause) {
+            usleep(10000);
+            continue;
+        }
         demo_draw(demo);
         demo->curFrame++;
         if (demo->frameCount != INT32_MAX && demo->curFrame == demo->frameCount) {
