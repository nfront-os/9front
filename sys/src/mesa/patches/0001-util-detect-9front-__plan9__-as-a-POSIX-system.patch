From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: port <port@localhost>
Date: Thu, 22 Oct 2026 07:13:27 +0200
Subject: [PATCH] util: detect 9front (__plan9__) as a POSIX system

---
 src/util/detect_os.h | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/util/detect_os.h b/src/util/detect_os.h
index 7403724..c99439b 100644
--- a/src/util/detect_os.h
+++ b/src/util/detect_os.h
@@ -91,6 +91,11 @@
 #define DETECT_OS_POSIX 1
 #endif
 
+#if defined(__plan9__)
+#define DETECT_OS_PLAN9 1
+#define DETECT_OS_POSIX 1
+#endif
+
 
 /*
  * Make sure DETECT_OS_* are always defined, so that they can be used with #if
@@ -146,5 +151,8 @@
 #ifndef DETECT_OS_MANAGARM
 #define DETECT_OS_MANAGARM 0
 #endif
+#ifndef DETECT_OS_PLAN9
+#define DETECT_OS_PLAN9 0
+#endif
 
 #endif /* DETECT_OS_H */
