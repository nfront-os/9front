From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: port <port@localhost>
Date: Thu, 22 Oct 2026 07:13:27 +0200
Subject: [PATCH] util/memstream: a temporary file on 9front, which has no
 open_memstream

---
 src/util/memstream.c | 19 ++++++++++++++-----
 src/util/memstream.h |  7 ++++++-
 2 files changed, 20 insertions(+), 6 deletions(-)

diff --git a/src/util/memstream.c b/src/util/memstream.c
index bd909b7..5330632 100644
--- a/src/util/memstream.c
+++ b/src/util/memstream.c
@@ -63,6 +63,13 @@ u_memstream_open(struct u_memstream *mem, char **bufp, size_t *sizep)
    }
 
    return success;
+#elif defined(__plan9__)
+   mem->f = tmpfile();
+   *bufp = NULL;
+   *sizep = 0;
+   mem->bufp = bufp;
+   mem->sizep = sizep;
+   return mem->f != NULL;
 #else
    FILE *const f = open_memstream(bufp, sizep);
    mem->f = f;
@@ -70,7 +77,7 @@ u_memstream_open(struct u_memstream *mem, char **bufp, size_t *sizep)
 #endif
 }
 
-#ifdef _WIN32
+#ifdef U_MEMSTREAM_TMPFILE
 static void
 u_memstream_update_buffer(struct u_memstream *mem)
 {
@@ -87,16 +94,18 @@ u_memstream_update_buffer(struct u_memstream *mem)
    }
    *mem->sizep = size;
 }
-#endif /* _WIN32 */
+#endif /* U_MEMSTREAM_TMPFILE */
 
 void
 u_memstream_close(struct u_memstream *mem)
 {
    FILE *const f = mem->f;
 
-#ifdef _WIN32
+#ifdef U_MEMSTREAM_TMPFILE
    u_memstream_update_buffer(mem);
+#ifndef __plan9__
    remove(mem->temp);
+#endif
 #endif
 
    fclose(f);
@@ -105,10 +114,10 @@ u_memstream_close(struct u_memstream *mem)
 int
 u_memstream_flush(struct u_memstream *mem)
 {
-#ifndef _WIN32
+#ifndef U_MEMSTREAM_TMPFILE
    return fflush(mem->f);
 #else
    u_memstream_update_buffer(mem);
    return 0;
-#endif /* _WIN32 */
+#endif /* U_MEMSTREAM_TMPFILE */
 }
diff --git a/src/util/memstream.h b/src/util/memstream.h
index 42f374c..6f8f0fc 100644
--- a/src/util/memstream.h
+++ b/src/util/memstream.h
@@ -43,10 +43,15 @@
 extern "C" {
 #endif
 
+/* no open_memstream: a temporary file, copied out on flush and close */
+#if defined(_WIN32) || defined(__plan9__)
+#define U_MEMSTREAM_TMPFILE 1
+#endif
+
 struct u_memstream
 {
    FILE *f;
-#ifdef _WIN32
+#ifdef U_MEMSTREAM_TMPFILE
    char **bufp;
    size_t *sizep;
    char temp[PATH_MAX];
