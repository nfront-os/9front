From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: port <port@localhost>
Date: Thu, 22 Oct 2026 07:13:27 +0200
Subject: [PATCH] venus: no sys/syscall.h on 9front; a thread is a process
 there (getpid)

---
 src/virtio/vulkan/vn_common.h | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/virtio/vulkan/vn_common.h b/src/virtio/vulkan/vn_common.h
index 86235f6..ea071c3 100644
--- a/src/virtio/vulkan/vn_common.h
+++ b/src/virtio/vulkan/vn_common.h
@@ -52,7 +52,9 @@
 #if DETECT_OS_WINDOWS
 #include <processthreadsapi.h>
 #else
+#if !DETECT_OS_PLAN9
 #include <sys/syscall.h>
+#endif
 
 #include "drm-uapi/drm_fourcc.h"
 #include "util/libsync.h"
@@ -648,6 +650,8 @@ vn_gettid(void)
    return syscall(SYS_thr_self);
 #elif DETECT_OS_WINDOWS
    return GetCurrentThreadId();
+#elif DETECT_OS_PLAN9
+   return getpid(); /* a thread is a process */
 #else
    return syscall(SYS_gettid);
 #endif
