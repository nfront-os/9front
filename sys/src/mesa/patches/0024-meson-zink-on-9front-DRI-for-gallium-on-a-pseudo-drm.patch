From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stefan Hertenberger <erde74@gmail.com>
Date: Tue, 3 Nov 2026 11:32:33 +0100
Subject: [PATCH] meson: zink on 9front: DRI for gallium on a pseudo-drm
 platform (libdrm's interface over gpu(4), no KMS), as for kgsl

---
 meson.build | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/meson.build b/meson.build
index b8d43e6..1d096d0 100644
--- a/meson.build
+++ b/meson.build
@@ -361,7 +361,8 @@ with_vdrm = [
 ].contains(true)
 
 with_dri = false
-if with_gallium and (system_has_kms_drm or (with_gallium_zink and (freedreno_kmds.contains('kgsl') or host_machine.system() == 'darwin')))
+# 9front: zink over the Vulkan drivers, libdrm's interface over gpu(4) (no KMS)
+if with_gallium and (system_has_kms_drm or (with_gallium_zink and (freedreno_kmds.contains('kgsl') or ['darwin', 'plan9'].contains(host_machine.system()))))
   _glx = get_option('glx')
   _egl = get_option('egl')
   if _glx == 'dri' or _egl.enabled() or (_glx == 'disabled' and _egl.allowed())
@@ -422,7 +423,7 @@ elif ['windows', 'cygwin'].contains(host_machine.system())
   with_dri_platform = 'windows'
 elif system_has_kms_drm
   with_dri_platform = 'drm'
-elif host_machine.system() == 'gnu' or (freedreno_kmds.contains('kgsl') and with_gallium_zink)
+elif host_machine.system() == 'gnu' or ((freedreno_kmds.contains('kgsl') or host_machine.system() == 'plan9') and with_gallium_zink)
   with_dri_platform = 'pseudo-drm'
 else
   # FIXME: haiku doesn't use dri, and xlib doesn't use dri, probably should
