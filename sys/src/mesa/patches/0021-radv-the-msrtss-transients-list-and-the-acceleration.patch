From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stefan Hertenberger <erde74@gmail.com>
Date: Sun, 1 Nov 2026 23:40:37 +0100
Subject: [PATCH] radv: the msrtss transients' list and the acceleration
 structures' set made before a failed command stream destroys the command
 buffer (it walks both)

---
 src/amd/vulkan/radv_cmd_buffer.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/src/amd/vulkan/radv_cmd_buffer.c b/src/amd/vulkan/radv_cmd_buffer.c
index a8319c6..de81ba7 100644
--- a/src/amd/vulkan/radv_cmd_buffer.c
+++ b/src/amd/vulkan/radv_cmd_buffer.c
@@ -1289,6 +1289,10 @@ radv_create_cmd_buffer(struct vk_command_pool *pool, VkCommandBufferLevel level,
    if (cmd_buffer->qf != RADV_QUEUE_SPARSE) {
       const enum amd_ip_type ip = radv_queue_family_to_ring(pdev, cmd_buffer->qf);
       list_inithead(&cmd_buffer->upload.list);
+      list_inithead(&cmd_buffer->msrtss_transients); /* before an error destroys it (it walks the list) */
+      /* as the list: destroying the command buffer walks the set */
+      cmd_buffer->accel_struct_buffers = _mesa_pointer_set_create(NULL);
+      cmd_buffer->ray_history = UTIL_DYNARRAY_INIT;
 
       radv_cmd_buffer_init_shader_part_cache(device, cmd_buffer);
       result =
@@ -1301,9 +1305,6 @@ radv_create_cmd_buffer(struct vk_command_pool *pool, VkCommandBufferLevel level,
       for (unsigned i = 0; i < MAX_BIND_POINTS; i++)
          vk_object_base_init(&device->vk, &cmd_buffer->descriptors[i].push_set.set.base, VK_OBJECT_TYPE_DESCRIPTOR_SET);
 
-      cmd_buffer->accel_struct_buffers = _mesa_pointer_set_create(NULL);
-      cmd_buffer->ray_history = UTIL_DYNARRAY_INIT;
-      list_inithead(&cmd_buffer->msrtss_transients);
    }
 
    if (device->utrace.context) {
