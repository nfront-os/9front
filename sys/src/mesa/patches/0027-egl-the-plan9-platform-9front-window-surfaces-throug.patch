From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stefan Hertenberger <erde74@gmail.com>
Date: Tue, 3 Nov 2026 13:04:25 +0100
Subject: [PATCH] egl: the plan9 platform (9front): window surfaces through
 zink's kopper and VK_PLAN9_surface, a native window is a draw(3) window's
 name or 0 (the program's)

---
 include/kopper_interface.h            |   2 +
 meson.build                           |   3 +-
 meson.options                         |   2 +-
 src/egl/drivers/dri2/egl_dri2.c       |   5 +
 src/egl/drivers/dri2/egl_dri2.h       |  15 ++
 src/egl/drivers/dri2/platform_plan9.c | 258 ++++++++++++++++++++++++++
 src/egl/main/egldisplay.c             |   1 +
 src/egl/main/egldisplay.h             |   1 +
 src/egl/meson.build                   |   3 +
 9 files changed, 288 insertions(+), 2 deletions(-)
 create mode 100644 src/egl/drivers/dri2/platform_plan9.c

diff --git a/include/kopper_interface.h b/include/kopper_interface.h
index 7e30277..4303257 100644
--- a/include/kopper_interface.h
+++ b/include/kopper_interface.h
@@ -99,6 +99,8 @@ struct kopper_loader_info {
    int initial_swap_interval;
    bool present_opaque;
    uint32_t compression;
+   /* the native window's identity where the create info has none (9front: a NULL name is the program's window) */
+   const void *native;
 };
 
 #define __DRI_KOPPER_LOADER "DRI_KopperLoader"
diff --git a/meson.build b/meson.build
index 1d096d0..95b17f7 100644
--- a/meson.build
+++ b/meson.build
@@ -488,6 +488,7 @@ with_platform_wayland = _platforms.contains('wayland')
 with_platform_haiku = _platforms.contains('haiku')
 with_platform_windows = _platforms.contains('windows')
 with_platform_macos = _platforms.contains('macos')
+with_platform_plan9 = _platforms.contains('plan9')
 
 with_gfxstream_emulated_android = with_gfxstream_vk and with_platform_android and host_machine.system() == 'linux'
 if with_gfxstream_emulated_android
@@ -576,7 +577,7 @@ if with_egl
   endif
 
   # All the other platforms can be detected and cannot reach the native platform code
-  _undetectable_platforms = ['x11', 'haiku', 'android', 'surfaceless']
+  _undetectable_platforms = ['x11', 'haiku', 'android', 'surfaceless', 'plan9']
 
   # Don't enforce the native platform if none of the undetectable platforms are enabled
   _undetectable_platforms_enabled = []
diff --git a/meson.options b/meson.options
index 93a60e3..d989ffe 100644
--- a/meson.options
+++ b/meson.options
@@ -12,7 +12,7 @@ option(
   type : 'array',
   value : ['auto'],
   choices : [
-    'auto', 'x11', 'wayland', 'haiku', 'android', 'windows', 'macos',
+    'auto', 'x11', 'wayland', 'haiku', 'android', 'windows', 'macos', 'plan9',
   ],
   description : 'window systems to support. If this is set to `auto`, all ' +
                 'platforms applicable will be enabled.'
diff --git a/src/egl/drivers/dri2/egl_dri2.c b/src/egl/drivers/dri2/egl_dri2.c
index edee4ff..8935a60 100644
--- a/src/egl/drivers/dri2/egl_dri2.c
+++ b/src/egl/drivers/dri2/egl_dri2.c
@@ -897,6 +897,9 @@ dri2_initialize(_EGLDisplay *disp)
    case _EGL_PLATFORM_SURFACELESS:
       ret = dri2_initialize_surfaceless(disp);
       break;
+   case _EGL_PLATFORM_PLAN9:
+      ret = dri2_initialize_plan9(disp);
+      break;
    case _EGL_PLATFORM_DEVICE:
       ret = dri2_initialize_device(disp);
       break;
@@ -1006,6 +1009,8 @@ dri2_display_destroy(_EGLDisplay *disp)
       break;
    case _EGL_PLATFORM_DEVICE:
       break;
+   case _EGL_PLATFORM_PLAN9:
+      break;
    default:
       UNREACHABLE("Platform teardown is not properly hooked.");
       break;
diff --git a/src/egl/drivers/dri2/egl_dri2.h b/src/egl/drivers/dri2/egl_dri2.h
index aa5692a..ba76658 100644
--- a/src/egl/drivers/dri2/egl_dri2.h
+++ b/src/egl/drivers/dri2/egl_dri2.h
@@ -320,6 +320,10 @@ struct dri2_egl_surface {
    xcb_gcontext_t swapgc;
 #endif
 
+#ifdef HAVE_PLAN9_PLATFORM
+   char *plan9_name;	/* the window's image name; NULL: the program's window (/dev/winname) */
+#endif
+
 #ifdef HAVE_WAYLAND_PLATFORM
