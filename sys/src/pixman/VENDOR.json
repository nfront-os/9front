	"gen": [["pixman", "sh", "-c", "sed -e s/@PIXMAN_VERSION_MAJOR@/0/ -e s/@PIXMAN_VERSION_MINOR@/46/ -e s/@PIXMAN_VERSION_MICRO@/4/ pixman-version.h.in > pixman-version.h"]],
