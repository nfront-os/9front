[
	{
		"Name": "klibip-amd64",
		"Cflags": [
			"-m64",
			"-fno-pic",
			"-mcmodel=kernel",
			"-mno-red-zone",
			"-mno-sse",
			"-mno-sse2",
			"-mno-mmx",
			"-ffixed-r14",
			"-ffixed-r15",
			"-fno-builtin",
