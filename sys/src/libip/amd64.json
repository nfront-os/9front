			"bo.c",
			"classmask.c",
			"eipfmt.c",
			"equivip.c",
			"ipaux.c",
			"iplocalonifc.c",
			"ipremoteonifc.c",
			"myetheraddr.c",
			"myipaddr.c",
			"parseether.c",
			"parseip.c",
			"ptclbsum.c",
			"readipifc.c"
		]
	}
]