[
    {
        "Name": "klibip-386",
        "Cflags": [
            "-m32",
            "-nostdinc",
            "-fplan9-extensions",
            "-mno-sse",
            "-mno-sse2",
            "-mno-mmx",
            "-fno-pic",
            "-fno-builtin",
            "-fno-asynchronous-unwind-tables",
            "-fno-stack-protector",
            "-fno-omit-frame-pointer",
            "-fno-zero-initialized-in-bss",
            "-Os",
            "-gdwarf-2"
        ],
        "SourceFiles": [
            "bo.c",
            "classmask.c",
            "eipfmt.c",
            "equivip.c",
            "ipaux.c",
            "iplocalonifc.c",
            "ipremoteonifc.c",
            "myetheraddr.c",
            "myipaddr.c",
            "parseether.c",
            "parseip.c",
            "ptclbsum.c",
            "readipifc.c"
        ]
    }
]
