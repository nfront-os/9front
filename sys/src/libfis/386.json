[
    {
        "Name": "klibfis-386",
        "Cflags": [
            "-m32",
            "-march=pentium",
            "-mincoming-stack-boundary=2",
            "-mpreferred-stack-boundary=2",
            "-nostdinc",
            "-fplan9-extensions",
            "-mno-sse",
            "-mno-sse2",
            "-mno-mmx",
            "-fno-pic",
            "-fno-builtin",
            "-fno-asynchronous-unwind-tables",
            "-fno-stack-protector",
            "-fno-omit-frame-pointer",
            "-fno-zero-initialized-in-bss",
            "-Os",
            "-gdwarf-2"
        ],
        "SourceFiles": [
            "fis.c"
        ]
    }
]
