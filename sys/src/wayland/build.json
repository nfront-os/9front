[
	{
		"Name": "wayland-client",
		"Compat": true,
		"Cflags": [
			"-O2",
			"-Wall",
			"-fno-strict-aliasing",
			"-Iplan9",
			"-Igen",
			"-Ivendor/src"
		],
		"Library": "libwayland-client.a",
		"Install": "/$ARCH/lib.gcc/ape",
		"Objtag": "c",
		"SourceFiles": [
			"vendor/src/wayland-client.c",
			"vendor/src/connection.c",
			"vendor/src/wayland-util.c",
			"vendor/src/wayland-os.c",
			"gen/wayland-protocol.c",
			"gen/xdg-shell-protocol.c",
			"gen/linux-dmabuf-unstable-v1-protocol.c",
			"gen/xdg-decoration-unstable-v1-protocol.c"
		]
	},
	{
		"Name": "wayland-server",
		"Compat": true,
		"Cflags": [
			"-O2",
			"-Wall",
			"-fno-strict-aliasing",
			"-Iplan9",
			"-Igen",
			"-Ivendor/src"
		],
		"Library": "libwayland-server.a",
		"Install": "/$ARCH/lib.gcc/ape",
		"Objtag": "s",
		"SourceFiles": [
			"vendor/src/wayland-server.c",
			"vendor/src/event-loop.c",
			"vendor/src/wayland-shm.c",
			"vendor/src/connection.c",
			"vendor/src/wayland-util.c",
			"vendor/src/wayland-os.c",
			"gen/wayland-protocol.c",
			"gen/xdg-shell-protocol.c",
			"gen/linux-dmabuf-unstable-v1-protocol.c",
			"gen/xdg-decoration-unstable-v1-protocol.c"
		]
	},
	{
		"Name": "wayland-egl",
		"Compat": true,
		"Cflags": [
			"-O2",
			"-Wall",
			"-fno-strict-aliasing",
			"-Iplan9",
			"-Igen",
			"-Ivendor/src",
			"-Ivendor/egl"
		],
		"Library": "libwayland-egl.a",
		"Install": "/$ARCH/lib.gcc/ape",
		"Objtag": "e",
		"SourceFiles": [
			"vendor/egl/wayland-egl.c"
		]
	},
	{
		"Name": "wayland-cursor",
		"Compat": true,
		"Cflags": [
			"-O2",
			"-Wall",
			"-fno-strict-aliasing",
			"-Iplan9",
			"-Igen",
			"-Ivendor/src",
			"-Ivendor/cursor",
			"-DICONDIR=\"/lib/icons\""
		],
		"Library": "libwayland-cursor.a",
		"Install": "/$ARCH/lib.gcc/ape",
		"Objtag": "k",
		"SourceFiles": [
			"vendor/cursor/wayland-cursor.c",
			"vendor/cursor/os-compatibility.c",
			"vendor/cursor/xcursor.c"
		]
	}
]
