# What scripts/linux/import.py takes from a Linux tree into vendor/:
# globs relative to the tree's root; ! leaves out.  Files whose notice is
# not MIT-like (GPL only, or none) are not taken: REJECTED lists them,
# the layer (kpi/, replace/) stands in for what is needed of them.
drivers/gpu/drm/*.[ch]
drivers/gpu/drm/display/*.[ch]
drivers/gpu/drm/ttm/*.[ch]
drivers/gpu/drm/i915/**/*.[ch]
!drivers/gpu/drm/i915/gvt/**
drivers/gpu/drm/i915/Makefile
drivers/gpu/drm/Makefile
drivers/gpu/drm/display/Makefile
drivers/gpu/drm/ttm/Makefile
drivers/dma-buf/dma-resv.c
# the selftests of the fences and reservation objects (MIT): aux/i915 -T
drivers/dma-buf/selftest.[ch]
drivers/dma-buf/selftests.h
drivers/dma-buf/st-dma-*.c
include/drm/**/*.h
include/uapi/drm/*.h
include/linux/dma-resv.h
# kernel headers and code outside drm that are MIT-like
include/linux/hdmi.h
include/linux/aperture.h
include/linux/vgaarb.h
include/linux/vga_switcheroo.h
include/video/nomodeset.h
drivers/video/hdmi.c
include/linux/overflow.h
