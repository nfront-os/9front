[
	{
		"Name": "ape-cmd-cmds",
		"Include": [
			"/$ARCH/cflags.json",
			"/$ARCH/ape.json"
		],
		"Install": "/$ARCH/bin/ape/",
		"Cflags": [
			"-D_POSIX_SOURCE"
		],
		"Ape": true,
		"Oflags": [
			"--entry=_main"
		],
		"Libs": [
			"--start-group",
			"/$ARCH/lib/ape/libdraw.a",
			"/$ARCH/lib/ape/libplumb.a",
			"/$ARCH/lib/ape/libauth.a",
			"/$ARCH/lib/ape/libsec.a",
			"/$ARCH/lib/ape/libmp.a",
			"/$ARCH/lib/ape/libnet.a",
			"/$ARCH/lib/ape/libbsd.a",
			"/$ARCH/lib/ape/libl.a",
			"/$ARCH/lib/ape/libv.a",
			"/$ARCH/lib/ape/libz.a",
			"/$ARCH/lib/ape/libbz2.a",
			"/$ARCH/lib/ape/libbio.a",
			"/$ARCH/lib/ape/lib9.a",
			"/$ARCH/lib/ape/libfmt.a",
			"/$ARCH/lib/ape/libutf.a",
			"/$ARCH/lib/ape/libap.a",
			"--end-group"
		],
		"SourceFilesCmd": [
			"basename.c",
			"dirname.c",
			"kill.c",
			"uname.c"
		]
	}
]
