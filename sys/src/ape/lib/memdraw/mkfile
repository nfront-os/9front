# GCC port: libmemdraw for APE (gcc's APE programs: wsys' devdraw, ../9front-ui
# PLAN stage 4c), built from /sys/src/libmemdraw as ../draw is from libdraw
APE=/sys/src/ape
<$APE/config

LIB=/$objtype/lib/ape/libmemdraw.a

OFILES=\
	alloc.$O\
	arc.$O\
	cload.$O\
	cmap.$O\
	cread.$O\
	defont.$O\
	draw.$O\
	ellipse.$O\
	fillpoly.$O\
	hwdraw.$O\
	line.$O\
	load.$O\
	openmemsubfont.$O\
	poly.$O\
	read.$O\
	string.$O\
	subfont.$O\
	unload.$O\
	write.$O\
	warp.$O\
	pool.$O\

</sys/src/cmd/mksyslib

CFLAGS=-c $CFLAGS -D_POSIX_SOURCE -D_PLAN9_SOURCE -Duintptr=uintptr_t -D_tas=tas -D_ifmt=__ifmt -I. -I../9

%.$O: /sys/src/libmemdraw/%.c
	$CC $CFLAGS /sys/src/libmemdraw/$stem.c
