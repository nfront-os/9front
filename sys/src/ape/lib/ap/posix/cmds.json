[
	{
		"Name": "ape-lib-ap-posix-libap.a",
		"Include": [
			"/$ARCH/cflags.json",
			"/$ARCH/ape.json"
		],
		"Install": "/$ARCH/lib/ape/",
		"Cflags": [
			"-D_POSIX_SOURCE"
		],
		"Ape": true,
		"Library": "libap.a",
