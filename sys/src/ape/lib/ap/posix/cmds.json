			"getgrent.c",
			"getpwent.c",
			"locale.c",
			"mkfifo.c",
			"pathconf.c",
			"sigset.c",
			"sysconf.c",
			"tzset.c",
			"nanosleep.c"
		],
		"Append": true
	}
]
