			"-D_POSIX_SOURCE=",
			"-D_LIMITS_EXTENSION=",
			"-D_APE_GNU"
		],
		"Ape": true,
		"Library": "libap.a",
		"SourceFiles": [
			"asprintf.c",
			"at.c",
			"buf.c",
			"c11threads.c",
			"c99stdio.c",
			"c99time.c",
			"dlfcn.c",
			"epoll.c",
			"flock.c",
			"getentropy.c",
			"getopt_long.c",
			"getpagesize.c",
			"gnuext.c",
			"hwcap.c",
			"inttypes.c",
			"mman.c",
			"multibyte.c",
			"native.c",
			"newlocale.c",
			"posix.c",
			"pread.c",
			"pthread.c",
			"realpath.c",
			"semaphore.c",
			"sigchld.c",
			"stdlib.c",
			"string.c",
			"syslog.c",
			"truncate.c",
			"uchar.c",
			"wstdio.c",
			"xsysconf.c"
		],
		"Append": true
	}
]
