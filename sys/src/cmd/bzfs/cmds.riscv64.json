			"/$ARCH/lib.gcc/libpcm.a",
			"/$ARCH/lib.gcc/libttf.a",
			"/$ARCH/lib.gcc/libsat.a",
			"/$ARCH/lib.gcc/libscribble.a",
			"/$ARCH/lib.gcc/liblex.a",
			"/$ARCH/lib.gcc/libstdio.a",
			"/$ARCH/lib.gcc/libdtracy.a",
			"/$ARCH/lib.gcc/libaml.a",
			"/$ARCH/lib.gcc/libfis.a",
			"/$ARCH/lib.gcc/libbio.a",
