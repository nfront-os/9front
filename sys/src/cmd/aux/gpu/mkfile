</$objtype/mkfile

# intel: Intel GPUs exist on PCs only (and the driver flushes with clflush)
PCONLY=intel
DIRS=virtio `{~ $objtype (386 amd64) && echo $PCONLY}

all:V:	$DIRS

$DIRS:V:
	for (i in $DIRS) @{
		echo mk $i
		cd $i
		mk all
	}

install:V:
	for (i in $DIRS) @{
		echo mk $i
		cd $i
		mk install
	}

clean:V:
	for (i in $DIRS) @{
		cd $i
		mk clean
	}

nuke:V:
	for (i in $DIRS) @{
		cd $i
		mk nuke
	}
