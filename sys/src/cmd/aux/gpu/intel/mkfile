</sys/src/cmd/mkmany

$O.intelgpu: $I915

$I915 intelgpu.$O: i915_drv.h linux.h

gt/%.$O: gt/%.c
	$CC $CFLAGS -o $target gt/$stem.c

gem/%.$O: gem/%.c
	$CC $CFLAGS -o $target gem/$stem.c

display/%.$O: display/%.c
	$CC $CFLAGS -o $target display/$stem.c

plan9/%.$O: plan9/%.c
	$CC $CFLAGS -o $target plan9/$stem.c
