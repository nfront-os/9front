[
	{
		"Name": "grep",
		"Include": [
			"/$ARCH/cflags.json"
		],
		"Install": "/$ARCH/bin/",
		"Oflags": [
			"--entry=_main"
		],
		"Libs": [
			"/$ARCH/lib/libdisk.a",
			"/$ARCH/lib/lib9p.a",
			"/$ARCH/lib/libthread.a",
			"/$ARCH/lib/libauth.a",
			"/$ARCH/lib/libauthsrv.a",
			"/$ARCH/lib/libndb.a",
			"/$ARCH/lib/libip.a",
			"/$ARCH/lib/libsec.a",
			"/$ARCH/lib/libauth.a",
			"/$ARCH/lib/libmp.a",
			"/$ARCH/lib/libflate.a",
			"/$ARCH/lib/libregexp.a",
			"/$ARCH/lib/libString.a",
			"/$ARCH/lib/libbio.a",
			"/$ARCH/lib/libc.a"
		],
		"Pre": [
			"bash ../../../../scripts/yacc.sh -d grep.y"
		],
		"Program": "grep",
		"SourceFiles": [
			"y.tab.c",
			"main.c",
			"comp.c",
			"sub.c"
		]
	}
]
