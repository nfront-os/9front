		"Oflags": [
			"--entry=_main"
		],
		"Libs": [
			"/$ARCH/lib/libdisk.a",
			"/$ARCH/lib/lib9p.a",
			"/$ARCH/lib/libthread.a",
			"/$ARCH/lib/libauth.a",
			"/$ARCH/lib/libauthsrv.a",
			"/$ARCH/lib/libndb.a",
			"/$ARCH/lib/libip.a",
			"/$ARCH/lib/libsec.a",
