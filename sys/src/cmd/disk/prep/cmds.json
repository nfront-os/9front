			"/$ARCH/lib/libString.a",
			"/$ARCH/lib/libbio.a",
			"/$ARCH/lib/libc.a"
		],
		"Pre": [
			"bash ../../../../../scripts/yacc.sh -d calc.y"
		],
		"Program": "fdisk",
		"SourceFiles": [
			"fdisk.c",
			"edit.c",
			"y.tab.c"
		]
	},
