[
	{
		"Name": "rc",
		"Include": [
			"/$ARCH/cflags.json"
		],
		"Cflags": [
			"-DPlan9",
			"-DYYMALLOC=malloc",
			"-DYYFREE=free"
		],
		"Pre": [
			"bison -y -d syn.y"
		],
		"Program": "rc",
		"Install": "/$ARCH/bin/",
		"Oflags": [
			"--entry=_main"
		],
		"Libs": [
			"/$ARCH/lib/libc.a"
		],
		"SourceFiles": [
			"code.c",
			"exec.c",
			"getflags.c",
			"glob.c",
			"here.c",
			"io.c",
			"lex.c",
			"pcmd.c",
			"pfnc.c",
			"simple.c",
			"subr.c",
			"trap.c",
			"tree.c",
			"var.c",
			"havefork.c",
			"plan9.c",
			"y.tab.c"
		]
	}
]
