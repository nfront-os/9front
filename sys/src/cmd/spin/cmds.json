[
	{
		"Name": "cmd-spin-spin",
		"Include": [
			"/$ARCH/cflags.json",
			"/$ARCH/ape.json"
		],
		"Install": "/$ARCH/bin/",
		"Cflags": [
			"-D_POSIX_SOURCE",
			"-D_PLAN9"
		],
		"Pre": [
			"bash ../../../../scripts/yacc.sh -S -d spin.y"
		],
		"Ape": true,
		"Oflags": [
			"--entry=_main"
		],
		"Libs": [
			"--start-group",
			"/$ARCH/lib.gcc/ape/libdraw.a",
			"/$ARCH/lib.gcc/ape/libplumb.a",
			"/$ARCH/lib.gcc/ape/libauth.a",
			"/$ARCH/lib.gcc/ape/libsec.a",
			"/$ARCH/lib.gcc/ape/libmp.a",
			"/$ARCH/lib.gcc/ape/libnet.a",
			"/$ARCH/lib.gcc/ape/libbsd.a",
			"/$ARCH/lib.gcc/ape/libl.a",
			"/$ARCH/lib.gcc/ape/libv.a",
			"/$ARCH/lib.gcc/ape/libz.a",
			"/$ARCH/lib.gcc/ape/libbz2.a",
			"/$ARCH/lib.gcc/ape/libbio.a",
			"/$ARCH/lib.gcc/ape/lib9.a",
			"/$ARCH/lib.gcc/ape/libfmt.a",
			"/$ARCH/lib.gcc/ape/libutf.a",
			"/$ARCH/lib.gcc/ape/libap.a",
			"--end-group"
		],
		"Program": "spin",
		"SourceFiles": [
			"dstep.c",
			"flow.c",
			"guided.c",
			"main.c",
			"mesg.c",
			"msc_tcl.c",
			"pangen1.c",
			"pangen2.c",
			"pangen3.c",
			"pangen4.c",
			"pangen5.c",
			"pangen6.c",
			"pangen7.c",
			"reprosrc.c",
			"run.c",
			"sched.c",
			"spinlex.c",
			"structs.c",
			"sym.c",
			"vars.c",
			"y.tab.c",
			"tl_buchi.c",
			"tl_cache.c",
			"tl_lex.c",
			"tl_main.c",
			"tl_mem.c",
			"tl_parse.c",
			"tl_rewrt.c",
			"tl_trans.c"
		]
	}
]
