[
	{
		"Name": "qemu",
		"Program": "9qemu",
		"Install": "/arm64/bin",
		"Pre": [],
		"Clean": [
			"rebootcode.i",
			"../port/initcode.i",
			"boot",
			"qemu.bootfs.paq"
		],
		"Cflags": [
			"-fsigned-char",
			"-fno-pie",
			"-fno-pic",
			"-mcmodel=large",
			"-mgeneral-regs-only",
			"-mno-outline-atomics",
			"-ffixed-x26",
			"-ffixed-x27",
			"-fplan9-extensions",
			"-fcommon",
			"-fno-builtin",
			"-fno-asynchronous-unwind-tables",
			"-fno-stack-protector",
			"-fno-omit-frame-pointer",
			"-fno-zero-initialized-in-bss",
			"-Os",
			"-gdwarf-2",
			"-Wno-error=implicit-int",
			"-Wall",
			"-Wno-missing-braces",
			"-Wno-parentheses",
			"-Wno-unknown-pragmas",
			"-Wno-switch",
			"-Wno-sign-compare",
			"-Wno-sequence-point"
		],
		"Oflags": [
			"-T",
			"kernel.ld",
			"-z",
			"max-page-size=0x1000"
		],
		"Libs": [
			"/arm64/lib.gcc/klibmemlayer.a",
			"/arm64/lib.gcc/klibmemdraw.a",
			"/arm64/lib.gcc/klibdraw.a",
			"/arm64/lib.gcc/klibip.a",
			"/arm64/lib.gcc/klibsec.a",
			"/arm64/lib.gcc/klibmp.a",
			"/arm64/lib.gcc/klibc.a",
			"/arm64/lib.gcc/libgcc.a"
		],
		"Kernel": {
			"Systab": "/sys/src/libc/9syscall/sys.h",
			"ConfFile": "/sys/src/9/arm64/qemu",
			"Config": {
				"Code": [
					"int cpuserver = 0;"
				],
				"Dev": [
					"root",
					"cons",
					"swap",
					"env",
					"pipe",
					"proc",
					"mnt",
					"srv",
					"shr",
					"dup",
					"tls",
					"cap",
					"fs",
					"ether netif",
					"bridge log",
					"ip arp chandial ip ipv6 ipaux iproute netlog nullmedium pktmedium inferno",
					"uart",
					"usb",
					"rtc",
					"pci pci",
					"sd",
					"segment",
					"zp",
					"pmc pmcio"
				],
				"Link": [
					"usbxhcipci pci usbxhci",
					"ethervirtio10 pci virtio10mem",
					"ethersink",
					"ethermedium",
					"loopbackmedium",
					"netdevmedium",
					"pciqemu pci"
				],
				"Ip": [
					"tcp",
					"udp",
					"il",
					"ipifc",
					"icmp",
					"icmp6",
					"igmp",
					"ipmux"
				],
				"Misc": [
					"gic",
					"uartqemu",
					"sdvirtio10 pci sdscsi virtio10mem"
				]
			},
			"Ramfiles": {
				"boot": "boot",
				"paqfs": "/$objtype/bin/paqfs",
				"factotum": "/$objtype/bin/auth/factotum",
				"bootfs.paq": "qemu.bootfs.paq"
			}
		},
		"SourceFiles": [
			"l.S",
			"cache.v8.S",
			"clock.c",
			"fpu.c",
			"main.c",
			"mmu.c",
			"mem.c",
			"sysreg.c",
			"../port/random.c",
			"trap.c",
			"bootargs.c",
			"../ip/arp.c",
			"../ip/chandial.c",
			"../port/devbridge.c",
			"../port/devcap.c",
			"../port/devcons.c",
			"../port/devdup.c",
			"../port/devenv.c",
			"../port/devether.c",
			"../port/devfs.c",
			"../ip/devip.c",
			"../port/devmnt.c",
			"../port/devpci.c",
			"../port/devpipe.c",
			"../port/devpmc.c",
			"../port/devproc.c",
			"../port/devroot.c",
			"devrtc.c",
			"../port/devsd.c",
			"../port/devsegment.c",
			"../port/devshr.c",
			"../port/devsrv.c",
			"../port/devswap.c",
			"../port/devtls.c",
			"../port/devuart.c",
			"../port/devusb.c",
			"../port/devzp.c",
			"../ip/ethermedium.c",
			"../port/ethersink.c",
			"../port/ethervirtio10.c",
			"gic.c",
			"../ip/icmp.c",
			"../ip/icmp6.c",
			"../ip/igmp.c",
			"../ip/il.c",
			"../ip/inferno.c",
			"../ip/ip.c",
			"../ip/ipaux.c",
			"../ip/ipifc.c",
			"../ip/ipmux.c",
			"../ip/iproute.c",
			"../ip/ipv6.c",
			"../port/log.c",
			"../ip/loopbackmedium.c",
			"../ip/netdevmedium.c",
			"../port/netif.c",
			"../ip/netlog.c",
			"../ip/nullmedium.c",
			"../port/pci.c",
			"pciqemu.c",
			"../ip/pktmedium.c",
			"pmcio.c",
			"../port/sdscsi.c",
			"../port/sdvirtio10.c",
			"../ip/tcp.c",
			"uartqemu.c",
			"../ip/udp.c",
			"../port/usbxhci.c",
			"../port/usbxhcipci.c",
			"../port/virtio10mem.c",
			"../port/alarm.c",
			"../port/alloc.c",
			"../port/allocb.c",
			"../port/auth.c",
			"../port/cache.c",
			"../port/chan.c",
			"../port/dev.c",
			"../port/edf.c",
			"../port/fault.c",
			"../port/mul64fract.c",
			"../port/nix.c",
			"../port/nixcall.c",
			"../port/page.c",
			"../port/parse.c",
			"../port/pgrp.c",
			"../port/portclock.c",
			"../port/print.c",
			"../port/proc.c",
			"../port/qio.c",
			"../port/qlock.c",
			"../port/rdb.c",
			"../port/rebootcmd.c",
			"../port/segment.c",
			"../port/syscallfmt.c",
			"../port/sysfile.c",
			"../port/sysproc.c",
			"../port/syszio.c",
			"../port/sysexecelf.c",
			"../port/taslock.c",
			"../port/tod.c",
			"../port/xalloc.c",
			"../port/userinit.c"
		]
	}
]
