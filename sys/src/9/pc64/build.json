[
	{
		"Name": "pc64",
		"Program": "9pc64",
		"Install": "/amd64/bin",
		"Pre": [
			"cp ../pc/usbehci.h usbehci.h",
			"cp ../pc/screen.h screen.h",
			"cp ../pc/mp.h mp.h",
			"cp ../pc/io.h io.h",
			"cp ../pc/ahci.h ahci.h",
			"cp ../pc/yukdump.h yukdump.h"
		],
		"Cflags": [
			"-m64",
			"-fno-pic",
			"-mcmodel=kernel",
			"-mno-red-zone",
			"-mno-sse",
			"-mno-sse2",
			"-mno-mmx",
			"-fno-builtin",
			"-fno-asynchronous-unwind-tables",
			"-fno-stack-protector",
			"-fno-omit-frame-pointer",
			"-fno-zero-initialized-in-bss",
			"-Os",
			"-gdwarf-2",
			"-Wall",
			"-Wno-missing-braces",
			"-Wno-parentheses",
			"-Wno-unknown-pragmas",
			"-Wno-switch",
			"-Wno-sign-compare",
			"-Wno-sequence-point"
		],
		"Oflags": [
			"-Ttext=0xffffffff80110000",
			"-R4096",
			"-N"
		],
		"Libs": [
			"/amd64/lib/klibmemlayer.a",
			"/amd64/lib/klibmemdraw.a",
			"/amd64/lib/klibdraw.a",
			"/amd64/lib/klibip.a",
			"/amd64/lib/klibsec.a",
			"/amd64/lib/klibmp.a",
			"/amd64/lib/klibc.a",
			"/amd64/lib/klibfis.a",
			"/amd64/lib/klibaml.a",
			"/amd64/lib/klibdtracy.a"
		],
		"Kernel": {
			"Systab": "/sys/src/libc/9syscall/sys.h",
			"ConfFile": "/sys/src/9/pc64/pc64",
			"Config": {
				"Code": [
					"int cpuserver = 0;"
				],
				"Dev": [
					"root",
					"cons",
					"swap",
					"arch",
					"pnp pci",
					"env",
					"pipe",
					"proc",
					"mnt",
					"srv",
					"shr",
					"dup",
					"rtc",
					"tls",
					"cap",
					"kprof",
					"fs",
					"ether netif",
					"bridge log",
					"ip arp chandial ip ipv6 ipaux iproute netlog nullmedium pktmedium inferno",
					"draw screen vga vgax vgasoft",
					"mouse mouse",
					"vga pci",
					"sd",
					"aoe",
					"audio dma",
					"uart",
					"usb",
					"kbd",
					"segment",
					"vmx",
					"dtracy"
				],
				"Link": [
					"cputemp pci",
					"ether2114x pci",
					"ether79c970 pci",
					"ether8139 pci",
					"ether8169 pci ethermii",
					"ether82563 pci ethermii",
					"ether82598 pci",
					"etherx550 pci",
					"etherbcm pci",
					"etheri225 pci ethermii",
					"etherigbe pci ethermii",
					"ethersink",
					"etheryuk pci",
					"etheriwl pci wifi",
					"etherwpi pci wifi",
					"etherrt2860 pci wifi",
					"ethervirtio pci",
					"ethervirtio10 pci virtio10pc",
					"ethermedium",
					"loopbackmedium",
					"netdevmedium",
					"usbuhci pci",
					"usbohci pci",
					"usbehci pci usbehcipc",
					"usbxhcipci pci usbxhci",
					"audiohda pci",
					"pmmc pci"
				],
				"Ip": [
					"tcp",
					"udp",
					"rudp",
					"ipifc",
					"icmp",
					"icmp6",
					"igmp",
					"gre",
					"ipmux",
					"il"
				],
				"Misc": [
					"pci pcipc",
					"archgeneric devkbd i8259 i8253",
					"archacpi mp apic squidboy ec hpet",
					"archmp mp apic squidboy",
					"mtrr",
					"sdaoe",
					"sdide pci sdscsi",
					"sd53c8xx pci sdscsi",
					"sdiahci pci sdscsi led",
					"sdvirtio pci sdscsi",
					"sdvirtio10 pci sdscsi virtio10pc",
					"sdmmc pci pmmc",
					"sdnvme pci",
					"sdloop",
					"sdram",
					"uarti8250",
					"uartisa",
					"uartpci pci",
					"vgasoft =cur swcursor",
					"vgaigfx +cur",
					"vgaradeon +cur",
					"vgavesa",
					"dtracysys",
					"dtracytimer",
					"dtracydev"
				]
			},
			"Ramfiles": {
				"boot": "boot",
				"paqfs": "/$objtype/bin/paqfs",
				"factotum": "/$objtype/bin/auth/factotum",
				"bootfs.paq": "$CONF.bootfs.paq"
			}
		},
