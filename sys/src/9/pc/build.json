[
    {
        "Name": "pc",
        "Program": "9pc",
        "Install": "/386/bin",
        "Pre": [],
        "Cflags": [
            "-m32",
            "-fplan9-extensions",
            "-fno-pic",
            "-mno-sse",
            "-mno-sse2",
            "-mno-mmx",
            "-fno-builtin",
            "-fno-asynchronous-unwind-tables",
            "-fno-stack-protector",
            "-fno-omit-frame-pointer",
            "-fno-zero-initialized-in-bss",
            "-Os",
            "-gdwarf-2",
            "-Wall",
            "-Wno-missing-braces",
            "-Wno-parentheses",
            "-Wno-unknown-pragmas",
            "-Wno-switch",
            "-Wno-sign-compare",
            "-Wno-sequence-point",
            "-fcommon"
        ],
        "Oflags": [
            "-m",
            "elf_i386",
            "-T",
            "kernel.ld",
            "-z",
            "max-page-size=0x1000"
        ],
        "Libs": [
            "/386/lib.gcc/klibmemlayer.a",
            "/386/lib.gcc/klibmemdraw.a",
            "/386/lib.gcc/klibdraw.a",
            "/386/lib.gcc/klibip.a",
            "/386/lib.gcc/klibsec.a",
            "/386/lib.gcc/klibmp.a",
            "/386/lib.gcc/klibc.a",
            "/386/lib.gcc/klibfis.a",
            "/386/lib.gcc/klibaml.a",
            "/386/lib.gcc/klibdtracy.a",
            "/386/lib.gcc/libgcc.a"
        ],
        "Kernel": {
            "Systab": "/sys/src/libc/9syscall/sys.h",
            "ConfFile": "/sys/src/9/pc/pc",
            "Config": {
                "Code": [
                    "int cpuserver = 0;"
                ],
                "Dev": [
                    "root",
                    "cons",
                    "swap",
                    "arch",
                    "env",
                    "pipe",
                    "proc",
                    "mnt",
                    "srv",
                    "shr",
                    "dup",
                    "rtc",
                    "tls",
                    "cap",
                    "kprof",
                    "fs",
                    "segment",
                    "uart"
                ],
                "Link": [],
                "Ip": [],
                "Misc": [
                    "archgeneric devkbd i8259 i8253",
                    "uarti8250",
                    "uartisa"
                ]
            },
            "Ramfiles": {
                "boot": "boot",
                "paqfs": "/$objtype/bin/paqfs",
                "factotum": "/$objtype/bin/auth/factotum",
                "bootfs.paq": "$CONF.bootfs.paq"
            }
        },
        "SourceFiles": [
            "l.S",
            "cga.c",
            "fpu.c",
            "i8253.c",
            "i8259.c",
            "main.c",
            "memory.c",
            "mmu.c",
            "irq.c",
            "trap.c",
            "bootargs.c",
            "archgeneric.c",
            "devarch.c",
            "devkbd.c",
            "../port/alarm.c",
            "../port/alloc.c",
            "../port/allocb.c",
            "../port/auth.c",
            "../port/cache.c",
            "../port/chan.c",
            "../port/dev.c",
            "../port/edf.c",
            "../port/fault.c",
            "../port/iomap.c",
            "../port/memmap.c",
            "../port/page.c",
            "../port/parse.c",
            "../port/pgrp.c",
            "../port/portclock.c",
            "../port/print.c",
            "../port/proc.c",
            "../port/qio.c",
            "../port/qlock.c",
            "../port/random.c",
            "../port/rdb.c",
            "../port/rebootcmd.c",
            "../port/segment.c",
            "../port/syscallfmt.c",
            "../port/sysfile.c",
            "../port/sysproc.c",
            "../port/taslock.c",
