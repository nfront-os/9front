            "../port/devmnt.c",
            "../port/devsrv.c",
            "../port/devshr.c",
            "../port/devdup.c",
            "devrtc.c",
            "../port/devtls.c",
            "../port/devcap.c",
            "../port/devkprof.c",
            "../port/devfs.c",
            "../port/devsegment.c",
            "../port/devswap.c",
            "mtrr.c",
            "devvmx.c",
            "uarti8250.c",
